---
import Base from '../layouts/Base.astro';
import Info from '../components/Info.astro';
import SecHead from '../components/SecHead.astro';
import ChartCard from '../components/ChartCard.astro';
import FieldSelect from '../components/FieldSelect.astro';
import Pager from '../components/Pager.astro';
import DataTable from '../components/DataTable.astro';
import { trendsSVG } from '../lib/echartsSSR';
import { moneyShort, psf as fpsf, deltaPill } from '../lib/format';
import fs from 'node:fs';
import { fileURLToPath } from 'node:url';

const base = import.meta.env.BASE_URL;

// SSR the hero chart to inline SVG so it paints instantly — no JS, no fetch. The
// client swaps in the interactive canvas chart after hydration. Falls back to a
// client-only render if overview.json hasn't been generated yet (e.g. fresh clone).
type Kpi = { value: number | null; yoy: number | null };
type Stats = { medianPrice: Kpi; txns: Kpi; millionDollar: Kpi; medianPsf: Kpi };
let heroSVG: string;
let stats: Stats | null = null;
try {
  const path = fileURLToPath(new URL('../../public/data/overview.json', import.meta.url));
  const ov = JSON.parse(fs.readFileSync(path, 'utf8'));
  heroSVG = trendsSVG(ov.trends.lease, 1040, 380);
  stats = ov.stats ?? null;
} catch {
  heroSVG = '';
}

// Redfin-style hero KPI strip: a headline value + its year-on-year delta each.
const int = (n: number | null) => (n == null ? '—' : n.toLocaleString('en-SG'));
const kpis = stats
  ? [
      {
        cap: 'Median resale price',
        val: stats.medianPrice.value == null ? '—' : moneyShort(stats.medianPrice.value),
        yoy: stats.medianPrice.yoy,
      },
      { cap: 'Transactions · 12 mo', val: int(stats.txns.value), yoy: stats.txns.yoy },
      {
        cap: '1M+ flats · 12 mo',
        val: int(stats.millionDollar.value),
        yoy: stats.millionDollar.yoy,
      },
      {
        cap: 'Median PSF',
        val: stats.medianPsf.value == null ? '—' : fpsf(stats.medianPsf.value),
        yoy: stats.medianPsf.yoy,
      },
    ]
  : [];
---

<Base active="Market Overview" title="Market Overview | HDB Kaki">
  <!-- Start the data fetch during HTML parse, parallel to the JS, so charts paint sooner. -->
  <link
    slot="head"
    rel="preload"
    as="fetch"
    href={`${base}data/overview.json`}
    crossorigin="anonymous"
  />
  <section class="hero">
    <div class="wrap">
      <span class="eyebrow rise"><span class="dot"></span> Market Overview</span>
      <h1 class="title rise" style="animation-delay:.05s">
        How's the resale market <em>moving</em>?
      </h1>
      <p class="lede solo rise" style="animation-delay:.1s">
        Median prices, distributions and lease dynamics across every HDB resale transaction since
        2017.
      </p>
      {
        stats && (
          <div
            class="kpi-strip rise"
            style="animation-delay:.15s"
            aria-label="Market at a glance, last 12 months"
          >
            {kpis.map((k) => {
              const d = k.yoy == null ? null : deltaPill(k.yoy);
              return (
                <div class="kpi">
                  <span class="kpi-cap">{k.cap}</span>
                  <span class="kpi-val mono">{k.val}</span>
                  <span class={`pill ${d?.cls ?? 'flat'}`}>{d ? `${d.text} YoY` : 'n/a'}</span>
                </div>
              );
            })}
          </div>
        )
      }
    </div>
  </section>

  <main class="wrap pagepad">
    <!-- 01 · PRICE TRENDS -->
    <SecHead num="01" title="Price trends" rise>
      Median resale price over time. Switch the lens to compare by lease band, town or flat type.
    </SecHead>
    <div class="controls" style="margin-bottom:16px">
      <div class="chipset" id="trend-toggle">
        <button class="chip on" data-mode="lease">Lease band</button>
        <button class="chip" data-mode="flat">Flat type</button>
        <button class="chip" data-mode="town">Town</button>
      </div>
    </div>
    <!-- Town lens only: ~26 towns at once is unreadable, so a compact dropdown caps the
         comparison at a handful (busiest first). Hidden until the Town lens is active. -->
    <div class="controls" id="trend-town-picker" hidden style="margin-bottom:16px">
      <div class="town-select">
        <button
          type="button"
          class="town-select-btn"
          id="trend-town-btn"
          aria-haspopup="listbox"
          aria-expanded="false"
        >
          <span class="dots" id="trend-town-dots"></span>
          <span id="trend-town-label">Comparing towns</span>
          <span class="chev" aria-hidden="true">▾</span>
        </button>
        <div class="town-menu" id="trend-town-menu" hidden>
          <input
            type="text"
            class="town-menu-search"
            id="trend-town-search"
            placeholder="Search towns…"
            aria-label="Search towns"
            autocomplete="off"
          />
          <div
            class="town-menu-list"
            id="trend-town-list"
            role="listbox"
            aria-multiselectable="true"
          >
          </div>
          <div class="town-menu-foot" id="trend-town-foot"></div>
        </div>
      </div>
    </div>
    <ChartCard title="Median resale price by lease band" titleId="trend-title">
      <div id="chart-trends" class="chart-box" set:html={heroSVG} />
    </ChartCard>

    <!-- 02 · PRICE MAP -->
    <SecHead num="02" title="Price map">
      Median 4-room resale price, last 12 months — darker means pricier. Switch to subzones for a
      finer view; areas with fewer than 10 sales are left blank.
    </SecHead>
    <div class="controls" style="margin-bottom:16px">
      <div class="chipset" id="map-toggle">
        <button class="chip on" data-level="town">By town</button>
        <button class="chip" data-level="subzone">By subzone</button>
      </div>
    </div>
    <ChartCard title="Median resale price · 4-room · by town" titleId="map-title">
      <div class="map-wrap">
        <div id="chart-map" class="chart-box map-box"></div>
        <div class="map-zoom" role="group" aria-label="Zoom the map">
          <button type="button" id="map-zoom-in" class="map-zoom-btn" aria-label="Zoom in">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
          </button>
          <button type="button" id="map-zoom-out" class="map-zoom-btn" aria-label="Zoom out">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"></path></svg>
          </button>
          <button type="button" id="map-zoom-reset" class="map-zoom-btn" aria-label="Reset view">
            <svg viewBox="0 0 24 24" aria-hidden="true"
              ><path d="M3.5 12a8.5 8.5 0 1 0 2.4-5.9M4 4v3.2h3.2"></path></svg
            >
          </button>
        </div>
      </div>
    </ChartCard>

    <!-- 03 · DISTRIBUTION -->
    <SecHead num="03" title="Price distribution by town">
      <Info slot="titleTip" label="How do I read this box plot?"
        >The box holds the middle 50% of sales, the line is the median, and the whiskers reach the
        typical low and high.</Info
      >
      Spread of 4-room resale prices, last 12 months — box shows the middle 50%.
    </SecHead>
    <ChartCard title="Resale price spread · 4-room">
      <div id="chart-box" class="chart-box"></div>
    </ChartCard>

    <!-- 04 · LEASE RELATIONSHIP -->
    <SecHead num="04" title="Price & remaining lease">
      How 4-room resale price relates to years left on the lease.
    </SecHead>
    <div class="split" style="grid-template-columns:1.5fr 1fr">
      <ChartCard title="Resale price vs remaining lease">
        <div id="chart-scatter" class="chart-box"></div>
      </ChartCard>
      <ChartCard title="Transactions by lease band">
        <div id="chart-buckets" class="chart-box"></div>
      </ChartCard>
    </div>

    <!-- 05 · RECENT TRANSACTIONS -->
    <SecHead num="05" title="Recent transactions">
      Latest registered resale deals. Filter by town or flat type and page through the last 12
      months.
    </SecHead>
    <div class="controls" style="margin-bottom:16px">
      <FieldSelect label="Town" id="rec-town" />
      <FieldSelect label="Flat type" id="rec-flat" />
    </div>
    <div class="card table-card">
      <DataTable
        headers={[
          { label: 'Sold' },
          { label: 'Town' },
          { label: 'Address' },
          { label: 'Type' },
          { label: 'Area (sqft)', align: 'r' },
          { label: 'Price', align: 'r' },
          {
            label: 'PSF',
            align: 'r',
            tip: '<strong>Price per square foot</strong> — sale price ÷ floor area, so different-sized flats compare fairly.',
          },
        ]}
        bodyId="tbody-recent"
        loadingText="Loading market data…"
        stack
      />
      <div class="tbl-foot">
        <span id="recent-foot">&nbsp;</span>
        <Pager />
      </div>
    </div>
  </main>
</Base>

<style>
  .chart-box {
    width: 100%;
    height: 380px;
  }
  /* Stretch the SSR placeholder SVG to fill the box until the canvas chart hydrates. */
  #chart-trends svg {
    width: 100% !important;
    height: 100% !important;
    display: block;
  }
  /* .controls is display:flex, which beats the [hidden] UA rule — re-hide explicitly. */
  #trend-town-picker[hidden] {
    display: none;
  }
  /* Compact town picker for the trends "Town" lens: one button opening a searchable
     checklist. The chart's own legend shows which towns are drawn (it fits now that the
     comparison is capped), so this control is purely the selector. */
  .town-select {
    position: relative;
  }
  .town-select-btn {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: inherit;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--ink);
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-radius: 11px;
    padding: 9px 14px;
    box-shadow: var(--shadow);
    cursor: pointer;
  }
  .town-select-btn:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  .town-select-btn .dots {
    display: inline-flex;
    gap: 3px;
  }
  /* The dots are injected by the page script, so style them globally (see .tm-row note). */
  :global(.town-select-btn .dots i) {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: block;
  }
  .town-select-btn b {
    font-weight: 700;
  }
  .town-select-btn .chev {
    color: var(--ink-3);
    font-size: 11px;
    transition: transform 0.15s ease;
  }
  .town-select-btn[aria-expanded='true'] .chev {
    transform: rotate(180deg);
  }
  .town-menu {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    width: 300px;
    max-width: calc(100vw - 56px);
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-radius: 12px;
    box-shadow: var(--shadow-lg);
    padding: 8px;
    z-index: 20;
  }
  .town-menu-search {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--paper);
    padding: 8px 10px;
    font-family: inherit;
    font-size: 13px;
    color: var(--ink);
    outline: none;
    margin-bottom: 6px;
  }
  .town-menu-search:focus-visible {
    border-color: var(--ink);
  }
  .town-menu-list {
    max-height: 244px;
    overflow: auto;
  }
  /* Rows are injected by the page script, so they miss Astro's scope attribute — style
     them globally (same pattern as the injected .rec rows in town-analysis.astro). */
  :global(.tm-row) {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13.5px;
    color: var(--ink-2);
    padding: 7px 9px;
    border-radius: 8px;
    cursor: pointer;
    width: 100%;
    border: none;
    background: none;
    font-family: inherit;
    text-align: left;
  }
  :global(.tm-row:hover) {
    background: var(--paper);
  }
  :global(.tm-row.on) {
    color: var(--ink);
    font-weight: 600;
  }
  :global(.tm-row .dot) {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    flex: none;
    background: transparent;
    border: 1.5px solid var(--line);
  }
  :global(.tm-row.on .dot) {
    border: none;
  }
  :global(.tm-row .ck) {
    margin-left: auto;
    color: var(--good);
    font-size: 13px;
  }
  :global(.tm-row:disabled) {
    opacity: 0.4;
    cursor: default;
  }
  :global(.tm-row:disabled:hover) {
    background: none;
  }
  :global(.tm-empty) {
    font-size: 13px;
    color: var(--ink-3);
    padding: 10px 9px;
  }
  .town-menu-foot {
    font-size: 11.5px;
    color: var(--ink-3);
    font-family: var(--font-mono);
    padding: 8px 9px 4px;
    border-top: 1px solid var(--line);
    margin-top: 4px;
  }
  #chart-scatter,
  #chart-buckets {
    height: 320px;
  }
  /* Singapore is wide and short — give the choropleth more room than a plot box, but not so
     tall that it leaves empty bands above and below the island. */
  .map-box {
    height: 420px;
  }
  /* Positioning context for the overlaid zoom controls. */
  .map-wrap {
    position: relative;
  }
  .map-zoom {
    position: absolute;
    top: 10px;
    right: 10px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    z-index: 2;
  }
  .map-zoom-btn {
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    padding: 0;
    color: var(--ink-2);
    background: color-mix(in srgb, var(--paper-2) 92%, transparent);
    border: 1px solid var(--line);
    border-radius: 8px;
    cursor: pointer;
    box-shadow: 0 2px 8px -5px rgba(24, 20, 16, 0.4);
    transition:
      background 0.12s ease,
      color 0.12s ease,
      border-color 0.12s ease;
  }
  .map-zoom-btn svg {
    width: 16px;
    height: 16px;
    display: block;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .map-zoom-btn:hover {
    background: var(--paper-2);
    color: var(--ink);
    border-color: #cfc7b8;
  }
  .map-zoom-btn:active {
    transform: translateY(0.5px);
  }
  @media (max-width: 640px) {
    .map-zoom-btn {
      width: 30px;
      height: 30px;
    }
  }
  /* On a narrow phone the map fits to width, so a 460px box leaves a huge empty band.
     Shrink to roughly the map's own aspect + a horizontal legend strip. */
  @media (max-width: 640px) {
    .map-box {
      height: 300px;
    }
  }
</style>

<script>
  import echarts, { initChart } from '../lib/echarts';
  import {
    baseOption,
    palette,
    axisLabel,
    splitLine,
    axisLine,
    ink2,
    ink3,
    mono,
    sans,
  } from '../lib/echartsTheme';
  import { money, moneyShort, psf as fpsf, titleCase } from '../lib/format';
  import { byId as q } from '../lib/dom';
  import { createHyparquet } from '../lib/hyparquetClient';
  import {
    createUrlState,
    selectBinding,
    chipBinding,
    stateBinding,
    type UrlState,
  } from '../lib/urlState';

  // Landing renders from a single precomputed aggregate (webapp/update/emit_web.py), so the
  // default view needs no data engine. The one exception is the recent-transactions table:
  // filtering or paging past page 1 queries the data worker lazily.
  type Overview = {
    trends: Record<string, { quarter: string; series: string; v: number }[]>;
    box: any[];
    townMedians: { town: string; med: number; n: number }[];
    subzoneMedians: { sz: string; med: number; n: number }[];
    scatter: any[];
    buckets: any[];
    recent: any[];
    recentTotal: number;
    towns: string[];
    flatTypes: string[];
  };
  let OV: Overview;

  // Recent-transactions table, backed by the hyparquet data worker (resale.parquet, decoded
  // off the main thread). Only the recent filters/pager touch data; everything else renders
  // from overview.json.
  const { recent, warmWhenIdle } = createHyparquet();

  // URL-synced landing filters (see web/src/lib/urlState.ts), assigned in boot() once the
  // recent-transactions selects are populated. The chip/pager handlers below call
  // url?.sync() — url is always defined by the time a user can interact.
  let url: UrlState | undefined;

  // ---- 01 price trends (with lens toggle) ----
  // Initialised in boot(), after data loads, so the SSR placeholder SVG stays
  // visible until we can draw the interactive canvas chart in one step.
  let trendChart: ReturnType<typeof echarts.init> | undefined;
  const trendTitle: Record<string, string> = {
    lease: 'Median resale price by lease band',
    flat: 'Median resale price by flat type',
    town: 'Median resale price by town',
  };

  // The town lens has ~26 series — all at once it's an unreadable tangle. Instead we
  // show a curated handful the reader can swap via #trend-town-picker. The six-colour
  // brand palette caps the comparison so every line stays a distinct colour; we default
  // to five so the "add town" control is live (one free slot) on first view.
  const DEFAULT_TOWNS = 5;
  const MAX_TOWNS = palette.length; // 6 — one per brand colour
  let townsByVolume: string[] = [];
  const selectedTowns = new Set<string>();

  function renderTrends(mode: string) {
    if (!OV || !trendChart) return;
    q('trend-title').textContent = trendTitle[mode];
    q('trend-town-picker').hidden = mode !== 'town';

    const rows = OV.trends[mode];
    const quarters = [...new Set(rows.map((r) => r.quarter))].sort();
    const byKey = new Map(rows.map((r) => [r.series + '|' + r.quarter, Number(r.v)]));

    // Town names are stored uppercase, so title-case them for display; the town lens
    // draws only the reader's selection (ordered so tag colours match the lines).
    const keys =
      mode === 'town'
        ? townsByVolume.filter((t) => selectedTowns.has(t))
        : [...new Set(rows.map((r) => r.series))].sort();
    const label = (k: string) => (mode === 'town' ? titleCase(k) : k);

    const series = keys.map((key) => ({
      name: label(key),
      type: 'line' as const,
      smooth: true,
      showSymbol: false,
      emphasis: { focus: 'series' as const },
      data: quarters.map((qtr) => {
        const v = byKey.get(key + '|' + qtr);
        return v == null ? null : Math.round(v);
      }),
    }));

    trendChart.setOption(
      {
        ...baseOption(),
        color: palette,
        // The town lens is capped at MAX_TOWNS, so the legend fits like the other lenses.
        legend: {
          top: 0,
          right: 0,
          type: 'scroll',
          textStyle: { fontSize: 12 },
          icon: 'roundRect',
        },
        grid: { left: 66, right: 24, top: 40, bottom: 46, containLabel: false },
        tooltip: { trigger: 'axis', valueFormatter: (v: number) => (v == null ? '—' : money(v)) },
        xAxis: {
          type: 'category',
          data: quarters,
          boundaryGap: false,
          axisLabel: { ...axisLabel, interval: Math.ceil(quarters.length / 8) },
          axisLine,
          axisTick: { show: false },
        },
        yAxis: {
          type: 'value',
          scale: true,
          axisLabel: { ...axisLabel, formatter: (v: number) => moneyShort(v) },
          splitLine,
        },
        series,
      },
      true,
    );
  }

  // Rank towns by transaction volume (the choropleth's 4-room counts are a good proxy)
  // so the default selection is the busiest towns, then seed the picker.
  function initTownPicker() {
    const vol = new Map(OV.townMedians.map((r) => [r.town, r.n ?? 0]));
    townsByVolume = [...new Set(OV.trends.town.map((r) => r.series))].sort(
      (a, b) => (vol.get(b) ?? 0) - (vol.get(a) ?? 0),
    );
    selectedTowns.clear();
    townsByVolume.slice(0, DEFAULT_TOWNS).forEach((t) => selectedTowns.add(t));

    const btn = q('trend-town-btn');
    const menu = q('trend-town-menu');
    const search = q('trend-town-search') as HTMLInputElement;

    const open = () => {
      menu.hidden = false;
      btn.setAttribute('aria-expanded', 'true');
      search.value = '';
      renderTownList('');
      search.focus();
    };
    const close = () => {
      menu.hidden = true;
      btn.setAttribute('aria-expanded', 'false');
    };
    btn.addEventListener('click', () => (menu.hidden ? open() : close()));
    search.addEventListener('input', () => renderTownList(search.value));
    // Dismiss on outside click or Escape.
    document.addEventListener('click', (e) => {
      if (!menu.hidden && !(e.target as HTMLElement).closest('.town-select')) close();
    });
    menu.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Escape') {
        close();
        btn.focus();
      }
    });

    refreshTownButton();
  }

  // The dots + count on the trigger button, kept in sync with the current selection.
  function refreshTownButton() {
    const shown = townsByVolume.filter((t) => selectedTowns.has(t));
    q('trend-town-dots').innerHTML = shown
      .map((_, i) => `<i style="background:${palette[i % palette.length]}"></i>`)
      .join('');
    q('trend-town-label').textContent =
      `Comparing ${shown.length} town${shown.length === 1 ? '' : 's'}`;
  }

  // Build the checklist rows (filtered by the search box). A row toggles its town on/off;
  // we keep at least one town on the chart and cap the selection at MAX_TOWNS so every
  // line keeps a distinct palette colour.
  function renderTownList(filter: string) {
    const needle = filter.trim().toLowerCase();
    const matches = townsByVolume.filter((t) => titleCase(t).toLowerCase().includes(needle));
    const full = selectedTowns.size >= MAX_TOWNS;
    // Colour index follows the on-chart draw order (busiest-first among the selected).
    const colorOf = new Map(
      townsByVolume
        .filter((t) => selectedTowns.has(t))
        .map((t, i) => [t, palette[i % palette.length]]),
    );

    const list = q('trend-town-list');
    if (matches.length === 0) {
      list.innerHTML = `<div class="tm-empty">No towns match “${filter}”.</div>`;
    } else {
      list.innerHTML = matches
        .map((t) => {
          const on = selectedTowns.has(t);
          const locked = on && selectedTowns.size === 1; // can't remove the last town
          const disabled = (!on && full) || locked;
          const dot = on ? `style="background:${colorOf.get(t)}"` : '';
          return (
            `<button type="button" class="tm-row${on ? ' on' : ''}" role="option" aria-selected="${on}"` +
            `${disabled ? ' disabled' : ''} data-town="${t}">` +
            `<span class="dot" ${dot}></span>${titleCase(t)}${on ? '<span class="ck">✓</span>' : ''}</button>`
          );
        })
        .join('');
      list.querySelectorAll<HTMLButtonElement>('.tm-row[data-town]').forEach((row) =>
        row.addEventListener('click', (e) => {
          // Re-rendering the list below detaches this row, so without stopping the
          // event the bubbled document handler would read it as an outside click and
          // close the menu — but a multi-select should stay open while picking.
          e.stopPropagation();
          const t = row.dataset.town!;
          if (selectedTowns.has(t)) selectedTowns.delete(t);
          else selectedTowns.add(t);
          refreshTownButton();
          renderTownList(filter);
          renderTrends('town');
        }),
      );
    }

    q('trend-town-foot').textContent = full
      ? `${MAX_TOWNS} of ${MAX_TOWNS} max · untick one to swap`
      : `${selectedTowns.size} of ${MAX_TOWNS} max selected`;
  }

  document.querySelectorAll<HTMLButtonElement>('#trend-toggle .chip').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('#trend-toggle .chip').forEach((b) => b.classList.remove('on'));
      btn.classList.add('on');
      renderTrends(btn.dataset.mode!);
      url?.sync();
    });
  });

  // ---- 02 price choropleth (town / subzone) ----
  // Median 4-room price over the last 12 months, painted onto URA boundaries. Two
  // levels share the same slice so switching is a true zoom-in: towns join by name;
  // subzones are point-in-polygon'd in emit_web.py and greyed out below minN sales.
  const MAP_LEVELS = {
    town: {
      geo: 'geo/sg-towns.geojson',
      mapName: 'sg-towns',
      minN: 0,
      title: 'Median resale price · 4-room · by town',
      rows: () => OV.townMedians.map((r) => ({ name: r.town, med: Number(r.med), n: r.n })),
    },
    subzone: {
      geo: 'geo/sg-subzones.geojson',
      mapName: 'sg-subzones',
      minN: 10,
      title: 'Median resale price · 4-room · by subzone',
      rows: () => OV.subzoneMedians.map((r) => ({ name: r.sz, med: Number(r.med), n: r.n })),
    },
  } as const;
  type Level = keyof typeof MAP_LEVELS;

  let mapChart: ReturnType<typeof echarts.init> | undefined;
  let currentLevel: Level = 'town';
  let mapClickBound = false;
  let mapRoamBound = false;
  const geoReady = new Set<string>();

  // Auto level-of-detail: zoom past AUTO_IN drills the town choropleth into subzones; zooming back
  // below AUTO_OUT returns to towns. The gap between the two is hysteresis so hovering the boundary
  // doesn't strobe. `roamZoom` tracks the current absolute view zoom (accumulated from roam events,
  // since the map coord system exposes no public getZoom); `autoLevel` is the pin — a manual chip
  // click pauses auto until the next zoom.
  const AUTO_IN = 3.2;
  const AUTO_OUT = 2.6;
  let roamZoom = 0;
  let autoLevel = true;
  let switchingLevel = false;

  // Drill-in click-through: a clicked region (town or subzone) resolves to its HDB town so the
  // click opens Town Analysis. Subzones carry a `area` (planning area) that mostly *is* the town;
  // these central/Kallang planning areas roll up into their HDB town. Built from the geojson at
  // register (subzoneArea) and validated against the towns that actually have data (townSet, lazy
  // because OV loads async).
  const AREA_TO_TOWN: Record<string, string> = {
    KALLANG: 'KALLANG/WHAMPOA',
    'DOWNTOWN CORE': 'CENTRAL AREA',
    'MARINA EAST': 'CENTRAL AREA',
    'MARINA SOUTH': 'CENTRAL AREA',
    MUSEUM: 'CENTRAL AREA',
    NEWTON: 'CENTRAL AREA',
    ORCHARD: 'CENTRAL AREA',
    OUTRAM: 'CENTRAL AREA',
    'RIVER VALLEY': 'CENTRAL AREA',
    ROCHOR: 'CENTRAL AREA',
    'SINGAPORE RIVER': 'CENTRAL AREA',
    'STRAITS VIEW': 'CENTRAL AREA',
  };
  const subzoneArea = new Map<string, string>();
  let townSet: Set<string> | null = null;
  const towns = () => (townSet ??= new Set(OV.townMedians.map((r) => r.town)));
  // Resolve a clicked region to a linkable HDB town, or undefined if it doesn't map to one.
  function drillTown(name: string): string | undefined {
    if (currentLevel === 'town') return towns().has(name) ? name : undefined;
    const area = subzoneArea.get(name);
    if (!area) return undefined;
    const t = towns().has(area) ? area : AREA_TO_TOWN[area];
    return t && towns().has(t) ? t : undefined;
  }
  const labelsFit = () => window.innerWidth >= 640;
  const isNarrowMap = () => window.matchMedia('(max-width: 640px)').matches;
  // Transit-map label styling: plain caps. No per-char spacing; it ~doubled label width and
  // crowded the centre. Plain caps halve the footprint so more survive hideOverlap.
  const mapCaps = (s: string) => s.toUpperCase();

  async function registerGeo(url: string, name: string) {
    if (geoReady.has(name)) return;
    const g = await fetch(`${import.meta.env.BASE_URL}${url}`).then((r) => {
      if (!r.ok) throw new Error(`${url} ${r.status}`);
      return r.json();
    });
    echarts.registerMap(name, g);
    geoReady.add(name);
    // Capture subzone → planning-area for the drill-in click-through (see drillTown).
    if (name === 'sg-subzones')
      for (const f of g.features ?? [])
        if (f.properties?.name) subzoneArea.set(f.properties.name, f.properties.area);
  }

  async function renderMap(level: Level, view?: { zoom: number; center: number[] }) {
    currentLevel = level;
    const cfg = MAP_LEVELS[level];
    // Subzone geometry is only fetched the first time it's viewed, keeping initial load light.
    await registerGeo(cfg.geo, cfg.mapName);
    q('map-title').textContent = cfg.title;

    const rows = cfg.rows();
    const byName = new Map(rows.map((r) => [r.name, r]));
    const colored = rows.filter((r) => r.n >= cfg.minN);
    const vals = colored.map((r) => r.med);
    const lo = Math.min(...vals),
      hi = Math.max(...vals);

    // Placement — zoomed to fill the card. Singapore is wide and short, so on a narrow phone
    // the map fits to width and leaves a big empty band in the tall box; there we shrink the
    // box (CSS) and pull the map up to sit above a horizontal legend.
    const narrow = isNarrowMap();
    const baseZoom = narrow ? 1.4 : 1.82;
    const layout = {
      aspectScale: 1, // Singapore sits on the equator — keep lon/lat 1:1, don't squash
      // The desktop card is far wider than the island is tall, so zoom in to fill the frame
      // and cut the empty margins; phones already fit to width, so stay gentler. Nudge the
      // desktop map right of centre so its west coast clears the left-hand legend.
      // Start zoomed into the HDB heartland: the western Tuas tail (industrial, no HDB) sits off
      // the left edge rather than padding the frame. Shifting layoutCenter left crops the empty
      // west while keeping the eastern towns (Tampines/Pasir Ris) in view.
      // On an auto level switch, carry the roamed zoom + geo centre so town→subzone is a true
      // drill-in rather than a jump back to the default framing.
      zoom: view ? view.zoom : baseZoom,
      ...(view ? { center: view.center } : {}),
      layoutCenter: narrow ? ['48%', '40%'] : ['47%', '50%'],
      layoutSize: narrow ? '96%' : '100%',
    };

    // Label both levels on wider screens: overlaps are dropped so the overview stays legible,
    // and the zoom controls let you push in to reveal the tightly-packed central names (many
    // subzones only surface once zoomed). On phones the map stays clean and a tap shows the
    // tooltip instead.
    const showLabels = labelsFit();

    mapChart ??= initChart(q('chart-map'));
    // Choropleth deep-link: clicking a region opens its Town Analysis view. Works at both levels —
    // a subzone resolves to its parent HDB town via drillTown. Choropleth series only (index 0).
    if (!mapClickBound) {
      mapClickBound = true;
      mapChart.on('click', (p: any) => {
        if (p.seriesIndex !== 0 || !p.name) return;
        const town = drillTown(p.name);
        if (!town) return;
        // Subzone click deep-links straight to that subtown; a town click opens the whole town.
        const params = new URLSearchParams({ town });
        if (currentLevel === 'subzone') params.set('zone', p.name);
        location.href = `${import.meta.env.BASE_URL}town-analysis/?${params.toString()}`;
      });
    }
    // Track the live view zoom off roam and drive the auto level-of-detail switch. Bound once.
    // ECharts lowercases all event names, so the map-series roam event ('geoRoam') is 'georoam'.
    if (!mapRoamBound) {
      mapRoamBound = true;
      mapChart.on('georoam', onRoam as any);
    }
    mapChart.setOption(
      {
        ...baseOption(),
        tooltip: {
          trigger: 'item',
          formatter: (p: any) => {
            const d = byName.get(p.name);
            if (!d || d.n === 0) return `<b>${titleCase(p.name)}</b><br/>No HDB resale data`;
            if (d.n < cfg.minN)
              return `<b>${titleCase(p.name)}</b><br/><span style="color:${ink3}">${d.n} sales · too few to rank</span>`;
            return (
              `<b>${titleCase(p.name)}</b><br/>Median ${money(d.med)}` +
              `<br/><span style="color:${ink3}">${d.n.toLocaleString()} sales · last 12 mo</span>`
            );
          },
        },
        // Sequential magnitude → single-hue red ramp (light → dark), matching the app's
        // "red = pricier" convention. Never a rainbow. Only paints the choropleth layer.
        visualMap: {
          type: 'continuous',
          min: lo,
          max: hi,
          calculable: true,
          seriesIndex: 0,
          // Desktop: tall bar down the left, over the ocean margin. Narrow phones have no
          // side margin (map fills the width), so lay it flat along the bottom instead —
          // otherwise the vertical bar overlaps the landmass and its labels sit on the map.
          ...(narrow
            ? { orient: 'horizontal', left: 'center', bottom: 10, itemWidth: 12, itemHeight: 160 }
            : { orient: 'vertical', left: 16, bottom: 24, itemHeight: 150 }),
          inRange: { color: ['#fde8ec', '#f7b8c2', '#f07087', '#e11d3e', '#a80019'] },
          textStyle: { color: ink2, fontFamily: "'IBM Plex Mono', monospace", fontSize: 13 },
          formatter: (v: number) => moneyShort(v),
        },
        series: [
          {
            id: 'choropleth', // referenced by the zoom controls' geoRoam dispatch
            type: 'map',
            map: cfg.mapName,
            nameProperty: 'name',
            // Pan + wheel-zoom for a closer look; the overlaid +/− controls drive the same
            // roam view for those who'd rather click than scroll.
            roam: true,
            scaleLimit: { min: 1, max: 12 },
            ...layout,
            // No-data areas: a muted warm grey. Crisp raised-paper dividers between every region so
            // boundaries read clearly against both the red ramp and the beige no-data fills (paper,
            // not pure white — the Warm-Not-White rule).
            itemStyle: { areaColor: '#efeadf', borderColor: '#fffdf8', borderWidth: 1 },
            // Hover: bold the name and outline the region in ink. No label plate (the big collision
            // padding would make it a huge rectangle), and keep the region's own ramp colour
            // (`inherit`) instead of ECharts' default yellow emphasis fill.
            emphasis: {
              label: { fontWeight: 'bold' },
              itemStyle: { areaColor: 'inherit', borderColor: '#181410', borderWidth: 1.4 },
            },
            select: { disabled: true },
            // Town names sit on the priced regions only (no-data areas stay unlabelled), all-caps
            // like a transit map. A soft paper plate carries each name legibly across the full
            // light→dark red ramp — a halo alone can't rescue dark ink on the deep-red high-price
            // regions. Overlaps are dropped so the overview stays uncluttered (zoom reveals the rest).
            label: {
              show: false,
              formatter: (p: any) => mapCaps(p.name),
              color: '#181410',
              fontFamily: sans,
              fontSize: 10.5,
              fontWeight: 500,
              // Halo only — no plate. A strong paper text-border carries legibility over the ramp.
              // The background stays transparent (nothing visible), but the padding still inflates
              // each label's *collision* box, so in the dense centre hideOverlap drops the weaker
              // neighbour instead of stacking two names (minMargin is a no-op for map series).
              backgroundColor: 'transparent',
              padding: [18, 6],
              borderRadius: 0,
              // Softer, more translucent halo — a near-white outline read as jarring on the deep-red
              // regions. Lower opacity still separates the ink from the ramp without a hard rim.
              textBorderColor: 'rgba(246,242,234,0.7)',
              textBorderWidth: 3,
            },
            // Drop colliding labels (map series can't draw leader lines). The clearance that
            // decides "too close, hide one" comes from the label's padding above, not minMargin
            // (a no-op here). Zoom in, or hover, to reach the towns this hides.
            labelLayout: { hideOverlap: true },
            data: colored.map((r) => ({ name: r.name, value: r.med, label: { show: showLabels } })),
          },
        ],
      },
      true,
    );
    // The view now sits at this zoom (default framing, or the carried-over roam zoom on a switch).
    roamZoom = layout.zoom;
  }

  // ---- auto level-of-detail (town ⇄ subzone by zoom) ----
  // Read the geo coordinate the container centre currently points at, so a level switch can re-centre
  // there. The map coord system has no public getZoom, so `roamZoom` is tracked separately via roam.
  function readMapView(): { zoom: number; center: number[] } | null {
    const cs: any = (mapChart as any)?.getModel()?.getSeriesByIndex(0)?.coordinateSystem;
    if (!mapChart || !cs || typeof cs.pointToData !== 'function') return null;
    const center = cs.pointToData([mapChart.getWidth() / 2, mapChart.getHeight() / 2]);
    return { zoom: roamZoom, center };
  }

  function setActiveChip(level: Level) {
    document
      .querySelectorAll<HTMLElement>('#map-toggle .chip')
      .forEach((b) => b.classList.toggle('on', b.dataset.level === level));
  }

  async function switchLevel(level: Level) {
    if (switchingLevel || currentLevel === level) return;
    switchingLevel = true;
    setActiveChip(level);
    try {
      await renderMap(level, readMapView() ?? undefined);
    } catch (e) {
      console.error(e);
    } finally {
      switchingLevel = false;
    }
  }

  function onRoam(p: any) {
    // Accumulate absolute view zoom from the incremental roam factor (pan events carry no zoom).
    if (p && p.zoom != null) {
      roamZoom = Math.min(12, Math.max(1, roamZoom * p.zoom));
      autoLevel = true; // any manual pin is released the moment the user zooms again
    }
    if (switchingLevel || !autoLevel) return;
    if (currentLevel === 'town' && roamZoom >= AUTO_IN) switchLevel('subzone');
    else if (currentLevel === 'subzone' && roamZoom <= AUTO_OUT) switchLevel('town');
  }

  document.querySelectorAll<HTMLButtonElement>('#map-toggle .chip').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (btn.classList.contains('on')) return;
      setActiveChip(btn.dataset.level as Level);
      // A manual pick pins the level: pause the zoom-driven auto-switch until the user zooms again
      // (see onRoam), so auto doesn't immediately override the choice at the current zoom.
      autoLevel = false;
      renderMap(btn.dataset.level as Level).catch((e) => console.error(e));
      url?.sync();
    });
  });

  // Overlaid +/− controls: drive the same roam view as the wheel. Zoom toward the map's own centre
  // (its view rect), NOT the container centre — the map sits left-of-centre (layoutCenter 47% + the
  // left-hand legend), so zooming toward the container centre would drift it sideways as it scales.
  function zoomMap(factor: number) {
    if (!mapChart) return;
    const cs: any = (mapChart as any).getModel()?.getSeriesByIndex(0)?.coordinateSystem;
    const r = cs?.getViewRect?.();
    const originX = r ? r.x + r.width / 2 : mapChart.getWidth() / 2;
    const originY = r ? r.y + r.height / 2 : mapChart.getHeight() / 2;
    mapChart.dispatchAction({
      type: 'geoRoam',
      componentType: 'series',
      seriesId: 'choropleth',
      zoom: factor,
      originX,
      originY,
    });
  }
  q('map-zoom-in').addEventListener('click', () => zoomMap(1.5));
  q('map-zoom-out').addEventListener('click', () => zoomMap(1 / 1.5));
  // Reset returns to the town overview at the default framing and re-enables the auto level switch
  // (the default zoom is a town-level view, so snap the level back to match).
  q('map-zoom-reset').addEventListener('click', () => {
    autoLevel = true;
    setActiveChip('town');
    renderMap('town').catch((e) => console.error(e));
  });

  // ---- 03 box plot by town ----
  function renderBox() {
    const rows = OV.box;
    const chart = initChart(q('chart-box'));
    chart.setOption({
      ...baseOption(),
      grid: { left: 64, right: 20, top: 20, bottom: 78, containLabel: false },
      tooltip: { trigger: 'item' },
      xAxis: {
        type: 'category',
        data: rows.map((r) => titleCase(r.town)),
        axisLabel: { ...axisLabel, rotate: 38 },
        axisLine,
        axisTick: { show: false },
      },
      yAxis: {
        type: 'value',
        scale: true,
        splitLine,
        axisLabel: { ...axisLabel, formatter: (v: number) => moneyShort(v) },
      },
      series: [
        {
          type: 'boxplot',
          itemStyle: { color: '#efeadf', borderColor: '#181410' },
          data: rows.map((r) => [
            Number(r.mn),
            Number(r.q1),
            Number(r.med),
            Number(r.q3),
            Number(r.mx),
          ]),
        },
      ],
    });
  }

  // ---- 04 scatter + bucket counts ----
  function renderLease() {
    const bands = ['0-60 years', '61-80 years', '81-99 years'];
    const colors: Record<string, string> = {
      '0-60 years': palette[0],
      '61-80 years': palette[3],
      '81-99 years': palette[2],
    };
    const pts = OV.scatter;
    const scatter = initChart(q('chart-scatter'));
    scatter.setOption({
      ...baseOption(),
      grid: { left: 62, right: 20, top: 30, bottom: 44, containLabel: false },
      legend: { top: 0, right: 0, textStyle: { fontSize: 12 } },
      tooltip: {
        trigger: 'item',
        formatter: (p: any) => `${p.value[0]} yrs left<br/>${money(p.value[1])}`,
      },
      xAxis: {
        type: 'value',
        scale: true,
        name: 'Remaining lease (yrs)',
        nameLocation: 'middle',
        nameGap: 28,
        nameTextStyle: { color: ink3, fontSize: 11 },
        axisLabel,
        splitLine,
        axisLine,
      },
      yAxis: {
        type: 'value',
        scale: true,
        axisLabel: { ...axisLabel, formatter: (v: number) => moneyShort(v) },
        splitLine,
      },
      series: bands.map((b) => ({
        name: b.replace(' years', ''),
        type: 'scatter',
        symbolSize: 6,
        itemStyle: { color: colors[b], opacity: 0.55 },
        data: pts.filter((p) => p.band === b).map((p) => [Number(p.x), Number(p.y)]),
      })),
    });

    const counts = OV.buckets;
    const buckets = initChart(q('chart-buckets'));
    buckets.setOption({
      ...baseOption(),
      grid: { left: 90, right: 40, top: 20, bottom: 30, containLabel: false },
      tooltip: { trigger: 'item', valueFormatter: (v: number) => Number(v).toLocaleString() },
      xAxis: {
        type: 'value',
        axisLabel: { show: false },
        splitLine: { show: false },
        axisLine: { show: false },
      },
      yAxis: {
        type: 'category',
        data: counts.map((c) => c.band.replace(' years', ' yrs')),
        axisLabel: { color: '#5b544a', fontSize: 12 },
        axisLine,
        axisTick: { show: false },
      },
      series: [
        {
          type: 'bar',
          barWidth: 22,
          itemStyle: {
            color: (p: any) => [palette[0], palette[3], palette[2]][p.dataIndex],
            borderRadius: 5,
          },
          label: {
            show: true,
            position: 'right',
            formatter: (p: any) => Number(p.value).toLocaleString(),
            color: ink3,
            fontFamily: mono,
            fontSize: 11,
          },
          data: counts.map((c) => Number(c.n)),
        },
      ],
    });
  }

  // ---- 05 recent transactions (filterable + paged) ----
  type RecentRow = {
    month: string;
    town: string;
    address: string;
    flat_type: string;
    floor_area_sqft: number;
    resale_price: number;
    psf: number;
  };
  const PAGE_SIZE = 20; // keep in sync with RECENT_PAGE_SIZE in webapp/update/emit_web.py
  let recentPage = 0;
  let recentTotal = 0;
  let recentReq = 0; // guards against out-of-order responses when paging quickly

  // Paint the table + footer + pager from a page of rows. recentPage/recentTotal
  // describe which slice this is, so the caller sets those before calling.
  function paintRecent(rows: RecentRow[]) {
    q('tbody-recent').innerHTML = rows
      .map(
        (r) => `<tr>
        <td class="num-cell" data-role="meta">${r.month}</td>
        <td data-role="meta">${titleCase(r.town)}</td>
        <td data-role="title">${titleCase(r.address)}</td>
        <td data-role="meta">${r.flat_type}</td>
        <td class="r num-cell" data-role="meta" data-suffix="sqft">${Number(r.floor_area_sqft).toLocaleString()}</td>
        <td class="r price" data-role="primary">${money(Number(r.resale_price))}</td>
        <td class="r num-cell" data-role="meta" data-suffix="psf">${fpsf(Number(r.psf))}</td>
        <td class="tbreak" aria-hidden="true"></td>
      </tr>`,
      )
      .join('');
    const start = rows.length ? recentPage * PAGE_SIZE + 1 : 0;
    const end = recentPage * PAGE_SIZE + rows.length;
    q('recent-foot').innerHTML = recentTotal
      ? `Showing ${start.toLocaleString()}–${end.toLocaleString()} of ${recentTotal.toLocaleString()} in the last 12 months`
      : 'No transactions match these filters';
    (q('rec-prev') as HTMLButtonElement).disabled = recentPage === 0;
    (q('rec-next') as HTMLButtonElement).disabled = end >= recentTotal;
  }

  // Initial render: page 1, no filters, straight from the snapshot — no data fetch.
  function renderRecent() {
    recentPage = 0;
    recentTotal = Number(OV.recentTotal);
    paintRecent(OV.recent as RecentRow[]);
  }

  // Any filter change or page turn goes through hyparquet, mirroring the snapshot's SQL
  // (same 12-month window + ORDER BY month DESC, resale_price DESC) with page slicing.
  async function loadRecent() {
    const token = ++recentReq;
    const town = (q('rec-town') as HTMLSelectElement).value;
    const flat = (q('rec-flat') as HTMLSelectElement).value;
    try {
      const { rows, total } = await recent({ town, flat, page: recentPage, pageSize: PAGE_SIZE });
      if (token !== recentReq) return; // a newer request superseded this one
      recentTotal = total;
      paintRecent(rows as RecentRow[]);
    } catch (e) {
      console.error(e);
      if (token === recentReq) q('recent-foot').textContent = 'Could not load transactions.';
    }
  }

  // Populate the filter dropdowns from the snapshot (no data fetch needed to list them).
  function fillRecentFilters() {
    (q('rec-town') as HTMLSelectElement).innerHTML =
      `<option value="__all" selected>All towns</option>` +
      OV.towns.map((t) => `<option value="${t}">${titleCase(t)}</option>`).join('');
    (q('rec-flat') as HTMLSelectElement).innerHTML =
      `<option value="__all" selected>All types</option>` +
      OV.flatTypes.map((f) => `<option value="${f}">${f}</option>`).join('');
    q('rec-town').addEventListener('change', () => {
      recentPage = 0;
      loadRecent();
      url?.sync();
    });
    q('rec-flat').addEventListener('change', () => {
      recentPage = 0;
      loadRecent();
      url?.sync();
    });
    q('rec-prev').addEventListener('click', () => {
      if (recentPage > 0) {
        recentPage--;
        loadRecent();
        url?.sync();
      }
    });
    q('rec-next').addEventListener('click', () => {
      recentPage++;
      loadRecent();
      url?.sync();
    });
  }

  // boot — one small fetch (overview.json), no data engine
  async function boot() {
    OV = await fetch(`${import.meta.env.BASE_URL}data/overview.json`).then((r) => {
      if (!r.ok) throw new Error(`overview.json ${r.status}`);
      return r.json();
    });
    // Replace the SSR placeholder SVG with the interactive canvas chart in one step.
    q('chart-trends').innerHTML = '';
    trendChart = initChart(q('chart-trends'));
    initTownPicker();
    renderTrends('lease');
    renderMap('town').catch((e) => console.error(e));
    renderBox();
    renderLease();
    renderRecent();
    fillRecentFilters();

    // URL-synced filter state. The trend/map toggles re-render client-side from the
    // snapshot (no DuckDB); only the recent-transactions filters/pager reach the engine.
    url = createUrlState(
      [
        chipBinding('#trend-toggle', 'trend', 'mode', 'lease'),
        chipBinding('#map-toggle', 'map', 'level', 'town'),
        selectBinding('rec-town', 'rtown', '__all'),
        selectBinding('rec-flat', 'rflat', '__all'),
        stateBinding(
          'rpage',
          () => String(recentPage),
          (v) => {
            recentPage = parseInt(v, 10) || 0;
          },
          '0',
        ),
      ],
      ['trend', 'map', 'rtown', 'rflat', 'rpage'],
    );

    // Deep-link restore. Everything above already painted the default snapshot view; here
    // we override from the URL when it deviates. Toggles just re-render; the recent table
    // reloads through DuckDB only if one of its own params (rtown/rflat/rpage) deviates.
    if (url.deviates()) {
      url.restore();
      const mode =
        (document.querySelector('#trend-toggle .chip.on') as HTMLElement | null)?.dataset.mode ??
        'lease';
      const level =
        ((document.querySelector('#map-toggle .chip.on') as HTMLElement | null)?.dataset
          .level as Level) ?? 'town';
      renderTrends(mode);
      if (level !== 'town') renderMap(level).catch((e) => console.error(e));
      if (deviatesRecent()) loadRecent();
    }
  }

  // Do the recent-transactions params (its own slice of the URL) deviate from default?
  // Gates whether restore boots DuckDB for the table — trend/map toggles never do.
  function deviatesRecent(): boolean {
    return (
      (q('rec-town') as HTMLSelectElement).value !== '__all' ||
      (q('rec-flat') as HTMLSelectElement).value !== '__all' ||
      recentPage !== 0
    );
  }
  boot();

  // Warm the recent-transactions worker at idle so the first filter/page turn is instant.
  // The landing renders from overview.json; filters/pages go through the hyparquet worker
  // (Save-Data / idle gated).
  warmWhenIdle();

  // Re-render the map when a resize crosses the 640px breakpoint (e.g. phone rotation):
  // the legend flips to horizontal and the framing shifts, and town labels appear or
  // disappear. A plain resize() would leave all of that stale until reload.
  let mapWasNarrow = isNarrowMap();
  window.addEventListener('resize', () => {
    trendChart?.resize();
    if (mapChart && isNarrowMap() !== mapWasNarrow) {
      mapWasNarrow = isNarrowMap();
      renderMap(currentLevel).catch((e) => console.error(e));
    } else {
      echarts.getInstanceByDom(q('chart-map'))?.resize();
    }
    echarts.getInstanceByDom(q('chart-box'))?.resize();
    echarts.getInstanceByDom(q('chart-scatter'))?.resize();
    echarts.getInstanceByDom(q('chart-buckets'))?.resize();
  });
</script>
