---
import Base from '../layouts/Base.astro';
import Info from '../components/Info.astro';
import Term from '../components/Term.astro';
import SecHead from '../components/SecHead.astro';
import ChartCard from '../components/ChartCard.astro';
import DataTable from '../components/DataTable.astro';
import LeafletMap from '../components/LeafletMap.astro';
---

<Base active="My Flat Insights" title="My Flat Insights | HDB Kaki">
  <!-- The data worker is warmed from JS (at idle after load); no declarative resource
       hints are needed for it here. -->
  <section class="hero">
    <div class="wrap">
      <span class="eyebrow rise"><span class="dot"></span> My Flat Insights</span>
      <h1 class="title rise" style="animation-delay:.05s">
        What's your flat <em>really</em> worth?
      </h1>
      <p class="lede solo rise" style="animation-delay:.1s">
        Start with your postal code, and we'll value your flat against nearby transactions.
      </p>

      <div class="form-card rise" style="animation-delay:.16s">
        <div class="form-grid">
          <div class="field">
            <label for="f-postal">Postal code</label>
            <input
              id="f-postal"
              class="big"
              type="text"
              inputmode="numeric"
              maxlength="6"
              placeholder="e.g. 560123"
              value=""
              autofocus
            />
            <div class="sub cue" id="f-postal-sub">Start here · your 6-digit code</div>
          </div>
          <div class="field">
            <label for="f-flat">Flat type</label>
            <select id="f-flat"></select>
            <div class="sub" id="f-flat-sub">&nbsp;</div>
          </div>
          <div class="field">
            <label for="f-storey">Storey</label>
            <select id="f-storey"></select>
            <div class="sub">Storey band</div>
          </div>
          <div class="field">
            <label for="f-area">Floor area (sqft)</label>
            <input id="f-area" type="number" min="200" max="3000" step="1" value="" />
            <div class="sub" id="f-area-sub">&nbsp;</div>
          </div>
          <div class="field">
            <label>Remaining lease</label>
            <div class="val" id="f-lease">—</div>
            <div class="sub" id="f-lease-sub">From records</div>
          </div>
          <div class="field">
            <label>Flat model</label>
            <div class="val" id="f-model">—</div>
            <div class="sub">From records</div>
          </div>
        </div>
        <div class="form-foot">
          <div class="resolved" id="resolved"></div>
          <button class="cta" id="get-insights">Get insights <span class="arrow">→</span></button>
        </div>
      </div>
    </div>
  </section>

  <section class="results">
    <div class="wrap">
      <!-- 01 VALUATION -->
      <SecHead num="01" title="Estimated valuation" hintId="val-hint">
        Modelled from median PSF of comparable sales in your town.
      </SecHead>

      <div class="card val-hero">
        <div class="val-main">
          <div class="val-label">Estimated market value</div>
          <div class="val-big" id="val-big">—</div>
          <div class="val-range-txt">
            Likely range <b id="val-low">—</b> – <b id="val-high">—</b>
          </div>
          <div class="rangebar">
            <div class="track">
              <div class="fill"></div><div class="marker" id="val-marker"></div>
            </div>
            <div class="scale">
              <span class="mono" id="scale-low">—</span><span>estimate</span><span
                class="mono"
                id="scale-high">—</span
              >
            </div>
          </div>
          <div class="toolbar">
            <button class="act act-share" id="copy-link" type="button">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
                <polyline points="16 6 12 2 8 6"></polyline>
                <line x1="12" y1="2" x2="12" y2="15"></line>
              </svg>
              Share
            </button>
            <span class="act-sep" aria-hidden="true"></span>
            <button
              class="act act-icon"
              id="dl-comps"
              type="button"
              title="Download comps (CSV)"
              aria-label="Download comparable sales as CSV"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
            </button>
            <button
              class="act act-icon"
              id="print-btn"
              type="button"
              title="Print / save PDF"
              aria-label="Print or save as PDF"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polyline points="6 9 6 2 18 2 18 9"></polyline>
                <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"
                ></path>
                <rect x="6" y="14" width="12" height="8"></rect>
              </svg>
            </button>
          </div>
          <div class="toast" id="copy-toast" role="status" aria-live="polite">
            ✓ Link copied · anyone who opens it sees this exact valuation
          </div>
        </div>
        <div class="val-side">
          <div class="vs-label">How we got here</div>
          <div class="vs-row">
            <span class="k">Comparable sales used</span><span class="v" id="vs-n">—</span>
          </div>
          <div class="vs-row">
            <span class="k"
              >Median PSF (<Term term="comps" end
                ><strong>Comps</strong> are recent resale sales of the same flat type nearby, from data.gov.sg.
                They set the base for your estimate, adjusted for storey band but not for exact lease
                or unit condition.</Term
              >)</span
            ><span class="v" id="vs-psf">—</span>
          </div>
          <div class="vs-row">
            <span class="k"
              ><Term term="Storey adjustment" end
                >How much your floor band shifts the estimate versus the base median.</Term
              ></span
            ><span class="v" id="vs-storey">—</span>
          </div>
          <div class="vs-row">
            <span class="k">Your floor area</span><span class="v" id="vs-area">—</span>
          </div>
          <div class="conf">
            <Term term="Confidence" end
              >Based on how many comparable sales we found nearby. More comps means a more reliable
              estimate.</Term
            >
            <span class="bars" id="conf-bars"></span>
            <span id="conf-label">—</span>
          </div>
          <p class="disclaimer">
            Indicative guide only. Not an official valuation for HDB, bank or CPF purposes.
          </p>
        </div>
      </div>

      <!-- One-page printable summary. Hidden on screen; the print stylesheet hides the
           app shell and reveals only this. Populated by fillPrintSummary() on each compute. -->
      <div class="print-summary" id="print-summary" aria-hidden="true">
        <div class="ps-brand">HDB Kaki · Flat valuation</div>
        <div class="ps-sub" id="ps-sub"></div>
        <div class="ps-est" id="ps-est">—</div>
        <div class="ps-rng" id="ps-rng"></div>
        <h4>Comparable sales</h4>
        <div id="ps-comps"></div>
        <h4>Benchmarks</h4>
        <div id="ps-bench"></div>
        <div class="ps-foot" id="ps-foot"></div>
      </div>

      <!-- 02 PRICE TRAJECTORY -->
      <SecHead num="02" title="Price trajectory" hintId="traj-hint">
        How your flat type has moved here over the years.
      </SecHead>

      <div class="split" style="grid-template-columns:1.55fr 1fr">
        <ChartCard title="Median PSF over time" titleId="traj-title">
          <span class="pill" id="traj-pill" slot="head">—</span>
          <div id="traj-chart" style="width:100%;height:300px"></div>
        </ChartCard>
        <div class="card returns">
          <div class="ret-head">Your return so far</div>
          <p class="ret-lede">
            Already bought this flat? Enter what you paid to see your gain and annual return against
            the town.
          </p>
          <div class="ret-inputs">
            <label
              >Purchase price
              <input
                id="r-paid"
                type="text"
                inputmode="numeric"
                autocomplete="off"
                placeholder="e.g. 380,000"
              /></label
            >
            <label
              >Year bought
              <input
                id="r-year"
                type="number"
                inputmode="numeric"
                min="1990"
                max="2026"
                placeholder="e.g. 2015"
              /></label
            >
          </div>
          <div class="ret-out" id="ret-out">
            <div class="ret-empty">Your appreciation will appear here.</div>
          </div>
        </div>
      </div>

      <!-- 03 BENCHMARKING -->
      <SecHead num="03" title="How it benchmarks" hintId="bench-hint">
        Your flat vs the town and island-wide market.
      </SecHead>

      <div class="bench-grid">
        <div class="card bench">
          <div class="bk">Estimated PSF</div><div class="bv" id="b1-v">—</div>
          <span class="pill" id="b1-pill">—</span>
          <div class="minibar" id="b1-bars"></div>
        </div>
        <div class="card bench">
          <div class="bk">Estimated value</div><div class="bv" id="b2-v">—</div>
          <span class="pill" id="b2-pill">—</span>
          <div class="minibar" id="b2-bars"></div>
        </div>
        <div class="card bench">
          <div class="bk">Floor area</div><div class="bv" id="b3-v">—</div>
          <span class="pill" id="b3-pill">—</span>
          <div class="minibar" id="b3-bars"></div>
        </div>
      </div>

      <div class="split" style="grid-template-columns:1.4fr 1fr;margin-top:18px">
        <ChartCard title="Where you sit in the market">
          <Info slot="titleTip" label="What does percentile mean?"
            >The share of nearby sales priced below your estimate. For example, 70th percentile
            beats about 70% of them.</Info
          >
          <span class="pill" id="pctile-pill" slot="head">—</span>
          <div id="dist-chart" style="width:100%;height:210px"></div>
          <div class="dist-cap" id="dist-cap">&nbsp;</div>
        </ChartCard>
        <div class="market-tiles">
          <div class="card mt">
            <div class="mt-k">Sales this window</div><div class="mt-v" id="mt-vel">—</div><div
              class="mt-s"
              id="mt-vel-s"
            >
              &nbsp;
            </div>
          </div>
          <div class="card mt">
            <div class="mt-k">Priciest nearby sale</div><div class="mt-v" id="mt-hi">—</div><div
              class="mt-s"
              id="mt-hi-s"
            >
              &nbsp;
            </div>
          </div>
          <div class="card mt">
            <div class="mt-k">Lowest nearby sale</div><div class="mt-v" id="mt-lo">—</div><div
              class="mt-s"
              id="mt-lo-s"
            >
              &nbsp;
            </div>
          </div>
        </div>
      </div>

      <!-- 04 LEASE & VALUE RUNWAY -->
      <SecHead num="04" title="Lease & value runway">
        How prices soften as the lease runs down, and the ages that affect CPF & loans.
      </SecHead>

      <div class="card lease-card">
        <div class="lease-top">
          <span class="t">Lease position</span>
          <span class="r"
            ><b id="lease-rem">—</b> of 99 years remaining · commenced <b id="lease-start">—</b
            ></span
          >
        </div>
        <div class="decay">
          <div class="grad"></div>
          <div class="ticks">
            <span>99</span><span>80</span><span>60</span><span>40</span><span>20</span><span>0</span
            >
          </div>
          <div class="now" id="lease-now"></div>
        </div>
        <div class="lease-flags" id="lease-flags"></div>
      </div>

      <ChartCard
        title="Median PSF by remaining lease"
        titleId="leasecurve-title"
        style="margin-top:18px"
      >
        <span class="chart-sub" id="leasecurve-sub" slot="head"
          >Same flat type, island-wide, last 24 months</span
        >
        <div id="lease-chart" style="width:100%;height:260px"></div>
      </ChartCard>

      <!-- 05 COMPARABLES -->
      <SecHead num="05" title="Nearby comparables" hintId="comp-hint">
        Recent sales of the same flat type in your town, same street first.
      </SecHead>

      <div class="card comp-wrap">
        <DataTable
          headers={[
            { label: 'Address' },
            { label: 'Storey' },
            { label: 'Area', align: 'r' },
            { label: 'Lease', align: 'r' },
            { label: 'Price', align: 'r' },
            { label: 'PSF', align: 'r' },
            { label: 'Sold', align: 'r' },
          ]}
          bodyId="comp-body"
          loadingText="Enter a postal code…"
          stack
        />
        <div class="comp-foot"><span id="comp-foot">&nbsp;</span></div>
      </div>

      <!-- 06 GETTING AROUND -->
      <SecHead num="06" title="Getting around">
        Straight-line distance to the nearest MRT, plus nearby food, supermarkets, and malls.
      </SecHead>

      <div class="ins-map-col">
        <div class="amenity-modes" id="ins-amenities" aria-label="Show nearby amenities" hidden>
          <button type="button" class="am-chip" data-cat="hawker" aria-pressed="false">
            <span class="am-dot" style="background: #d98a2b"></span>Food
          </button>
          <button type="button" class="am-chip" data-cat="supermarket" aria-pressed="false">
            <span class="am-dot" style="background: #2f9e8f"></span>Supermarkets
          </button>
          <button type="button" class="am-chip" data-cat="mall" aria-pressed="false">
            <span class="am-dot" style="background: #3b6ea5"></span>Malls
          </button>
        </div>
        <LeafletMap id="ins-map" minHeight="480px" />
        <div class="station-card" id="ins-walk" hidden>
          <div class="sc-head">
            <div class="sc-eyebrow">Nearest station</div>
            <div class="sc-nearest">
              <div class="sc-nearest-l">
                <span class="sc-name" id="sc-name"></span>
                <span class="sc-badges" id="sc-badges"></span>
              </div>
              <div class="sc-nearest-r">
                <div class="sc-fig">
                  <span class="sc-dist" id="sc-dist"></span><span class="sc-unit" id="sc-unit"
                  ></span>
                </div>
                <span class="sc-walk" id="sc-walk"></span>
              </div>
            </div>
          </div>
          <div class="sc-nearby-wrap" id="sc-nearby-wrap">
            <div class="sc-eyebrow">Nearby stations</div>
            <ul class="sc-nearby" id="sc-nearby"></ul>
          </div>
        </div>
        <p class="map-src">
          Amenities from OpenStreetMap, NEA &amp; SFA (data.gov.sg). Distances are straight-line.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .results {
    padding: 0 0 80px;
  }
  /* form */
  .form-card {
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    margin-top: 30px;
    overflow: hidden;
  }
  .form-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 0;
  }
  .field {
    padding: 18px 22px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .field:nth-child(3n) {
    border-right: none;
  }
  .field label {
    display: block;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 9px;
  }
  .field .val {
    font-size: 17px;
    font-weight: 500;
  }
  .field input,
  .field select {
    width: 100%;
    border: none;
    background: none;
    font-family: inherit;
    font-size: 17px;
    font-weight: 500;
    color: var(--ink);
    outline: none;
    padding: 0;
  }
  /* Every value occupies the same fixed-height box (tall enough for the 26px
     postal code) so the differently-sized values don't change their own cell's
     height. Because all six cells then have identical structure, the labels,
     values and sub-labels line up across each row with uniform gaps, whatever
     the font size. An explicit height (not just line-height) is needed because
     <select> ignores line-height for its box height. The postal glyphs are
     still larger; they just sit centred in the same box. */
  .field .val,
  .field input,
  .field select {
    box-sizing: border-box;
    display: block;
    height: 32px;
    line-height: 32px;
  }
  /* Restore a visible focus ring for keyboard users (outline:none above removes
     it for everyone). :focus-visible keeps it off for mouse/touch clicks. */
  .field input:focus-visible,
  .field select:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
    border-radius: 2px;
  }
  /* The postal code is the field people actively type into; a heavy ring around
     the big mono value looks jarring, so keep it unhighlighted. */
  .field input.big:focus-visible {
    outline: none;
  }
  .field input.big {
    font-family: var(--font-mono);
    font-size: 26px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .field select {
    cursor: pointer;
    /* A native <select> renders its text with a small, browser-specific left
       inset that padding can't remove, so the value drifts right of the label.
       appearance:none drops the native widget (and its inset) so the value sits
       flush-left like the inputs; the chevron is re-added as a background. This
       is the standard pattern (cf. Bootstrap's .form-select). The stroke colour
       is hard-coded to --ink-3 (#8c8479) because a data-URI SVG can't read a CSS
       variable — keep it in sync if that token changes. */
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
    padding-right: 18px;
    background: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='14' viewBox='0 0 10 14' fill='none' stroke='%238c8479' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><path d='M2.5 5.5 5 3l2.5 2.5'/><path d='M2.5 8.5 5 11l2.5-2.5'/></svg>")
      no-repeat right center;
    background-size: 10px 14px;
  }
  /* Hide the browser's native up/down spinner on the number fields. A stepper
     chevron here would only be decorative (it can't increment), so drop it and
     let these read as plain typed values like the postal field above. */
  .field input[type='number'] {
    -webkit-appearance: none;
    -moz-appearance: textfield;
    appearance: none;
  }
  .field input[type='number']::-webkit-outer-spin-button,
  .field input[type='number']::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  .field .sub {
    font-size: 12.5px;
    color: var(--ink-3);
    margin-top: 5px;
  }
  /* A gentle nudge toward the first action — kept subtle (muted, not red) so it
     guides without shouting. It self-clears once a postal resolves (see JS). */
  .field .sub.cue {
    color: var(--ink-2);
  }
  .form-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 22px;
    gap: 16px;
    flex-wrap: wrap;
  }
  .resolved {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: var(--ink-2);
  }
  .resolved .pin {
    width: 26px;
    height: 26px;
    border-radius: 8px;
    background: var(--red-wash);
    color: var(--red-ink);
    display: grid;
    place-items: center;
    font-size: 13px;
    flex: none;
  }
  .resolved b {
    color: var(--ink);
    font-weight: 600;
  }
  /* valuation hero */
  .val-hero {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    overflow: hidden;
    padding: 0;
  }
  .val-main {
    padding: 34px 36px;
  }
  .val-side {
    background: linear-gradient(160deg, #1c1712, #241d16);
    color: #f4efe6;
    padding: 34px;
  }
  .val-label {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .val-big {
    font-family: var(--font-newsreader);
    font-weight: 600;
    font-size: clamp(46px, 7vw, 68px);
    letter-spacing: -0.03em;
    line-height: 1;
    margin: 8px 0 4px;
  }
  .val-range-txt {
    font-size: 15px;
    color: var(--ink-2);
  }
  .val-range-txt b {
    color: var(--ink);
    font-family: var(--font-mono);
    font-weight: 600;
  }
  .rangebar {
    margin-top: 26px;
  }
  .rangebar .track {
    position: relative;
    height: 10px;
    border-radius: 999px;
    background: linear-gradient(90deg, #f0e7d8, #e9dcc7);
  }
  .rangebar .fill {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 12%;
    right: 12%;
    border-radius: 999px;
    background: linear-gradient(90deg, rgba(254, 1, 43, 0.25), rgba(254, 1, 43, 0.55));
  }
  .rangebar .marker {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--red);
    border: 3px solid #fff;
    transform: translate(-50%, -50%);
    box-shadow: 0 4px 12px -2px rgba(254, 1, 43, 0.7);
  }
  .rangebar .scale {
    display: flex;
    justify-content: space-between;
    margin-top: 10px;
    font-size: 12.5px;
    color: var(--ink-3);
  }
  .rangebar .scale .mono {
    color: var(--ink-2);
  }
  .val-side .vs-label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #b9ae9c;
  }
  .vs-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 13px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .vs-row .k {
    font-size: 14px;
    color: #d8cfc0;
  }
  .vs-row .v {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 15px;
  }
  .conf {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
    font-size: 13px;
    color: #e8e0d2;
  }
  .conf .bars {
    display: flex;
    gap: 3px;
  }
  :global(.conf .bars i) {
    width: 5px;
    height: 14px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.22);
  }
  :global(.conf .bars i.on) {
    background: #5bd08a;
  }
  .disclaimer {
    font-size: 11.5px;
