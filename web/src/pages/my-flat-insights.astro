<script>
  import 'leaflet/dist/leaflet.css';
  import 'leaflet.markercluster/dist/MarkerCluster.css';
  import 'leaflet.markercluster/dist/MarkerCluster.Default.css';
  import L from 'leaflet';
  import 'leaflet.markercluster';
  // The valuation reads resale.parquet via the hyparquet data worker: postal lookups, comps
  // and benchmarks are computed off the main thread and only the summaries cross back.
  import { byId as $ } from '../lib/dom';
  import { createHyparquet } from '../lib/hyparquetClient';
  import { createUrlState, selectBinding, inputBinding } from '../lib/urlState';
  import { downloadCsv } from '../lib/csv';

  // The valuation runs in the hyparquet Web Worker: the 236k-row scans (postal lookup,
  // comps, benchmarks, trajectory, lease curves) stay off the main thread; only small
  // summaries cross back. `q*` aliases avoid colliding with the page's own resolveBlock().
  const {
    resolveBlock: qResolveBlock,
    storeysAndArea: qStoreysArea,
    valuation: qValuation,
    warmWhenIdle,
  } = createHyparquet();

  // No default valuation is auto-loaded, so there's nothing to front-run. Warm the worker
  // speculatively at idle (skipped under Save-Data) so the parquet is decoded by the time the
  // user finishes typing their postal — without contending with first paint on this map- and
  // chart-heavy page.
  warmWhenIdle();
  import echarts, { initChart } from '../lib/echarts';
  import {
    baseOption,
    palette,
    axisLabel,
    splitLine,
    axisLine,
    ink3,
    red,
  } from '../lib/echartsTheme';
  import { money, moneyShort, psf as fpsf, titleCase, deltaPill } from '../lib/format';
  import { nearbyStations, haversineMeters, type Station } from '../lib/onemap';
  import { reformatWithCaret, parsePrice, computeReturns } from '../lib/returns';

  const NOW_YEAR = new Date().getFullYear();

  let block = { town: '', street: '', address: '', model: '', lc: 0 };
  let userLatLng: [number, number] | null = null;
  let resolvedPostal = 0; // the postal the form fields currently reflect

  // Remaining lease is derived straight from the block's lease commencement year in the
  // HDB dataset (99-year term) — it is not user-editable. Returns 0 when lc is unknown.
  const remainingLease = () =>
    block.lc ? Math.max(1, Math.min(99, 99 - (NOW_YEAR - block.lc))) : 0;

  // ---- ECharts: init once per container, reuse across recomputes ----
  const charts: Record<string, echarts.ECharts> = {};
  const ec = (id: string) => (charts[id] ??= initChart($(id)));
  // State the "returns" panel needs so it can recompute on input change without re-querying.
  let currentEstimate = 0;
  let currentComps: any[] = []; // last compute()'s comps — for the CSV export

  // URL-synced form state (see web/src/lib/urlState.ts). All default to '' so an empty form
  // yields an empty query string; a computed view syncs the full deep link. The selects are
  // populated async (f-flat by resolveBlock, f-storey by onFlatChange) — restoreFromUrl()
  // handles that ordering explicitly, so writes always land on real options.
  const url = createUrlState(
    [
      inputBinding('f-postal', 'postal', ''),
      selectBinding('f-flat', 'flat', ''),
      selectBinding('f-storey', 'storey', ''),
      inputBinding('f-area', 'area', ''),
    ],
    ['postal', 'flat', 'storey', 'area'],
  );
  let townYearPrice: Record<string, number> = {}; // 'YYYY' -> town median price for the flat type
  let latestYear = '';

  const med = (a: number[]) => {
    if (!a.length) return 0;
    const s = [...a].sort((x, y) => x - y);
    const m = s.length >> 1;
    return s.length % 2 ? s[m] : (s[m - 1] + s[m]) / 2;
  };
  const quantile = (sorted: number[], p: number) => {
    if (!sorted.length) return 0;
    const i = (sorted.length - 1) * p,
      lo = Math.floor(i),
      hi = Math.ceil(i);
    return sorted[lo] + (sorted[hi] - sorted[lo]) * (i - lo);
  };
  // ---- Leaflet map ----
  const map = L.map('ins-map', { scrollWheelZoom: false }).setView([1.3521, 103.8198], 12);
  L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
    attribution: '© OpenStreetMap © CARTO',
    maxZoom: 19,
    subdomains: 'abcd',
  }).addTo(map);

  // Fullscreen toggle — a small Leaflet control using the native Fullscreen API (no plugin). Sits
  // under the zoom control; expands the map container, then invalidateSize so Leaflet re-renders.
  const FsControl = L.Control.extend({
    onAdd() {
      const bar = L.DomUtil.create('div', 'leaflet-bar fs-ctrl');
      const btn = L.DomUtil.create('a', '', bar) as HTMLAnchorElement;
      btn.href = '#';
      btn.title = 'Toggle fullscreen';
      btn.setAttribute('role', 'button');
      btn.setAttribute('aria-label', 'Toggle fullscreen');
      const paint = () => {
        // Corner brackets: outward-pointing to enter fullscreen, inward to exit.
        const d = document.fullscreenElement
          ? 'M9 4v5H4M15 4v5h5M9 20v-5H4M15 20v-5h5'
          : 'M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5';
        btn.innerHTML =
          `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="${d}" fill="none" ` +
          'stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
      };
      paint();
      L.DomEvent.on(btn, 'click', (e) => {
        L.DomEvent.stop(e);
        const el = map.getContainer();
        if (document.fullscreenElement) document.exitFullscreen?.();
        else el.requestFullscreen?.();
      });
      document.addEventListener('fullscreenchange', () => {
        paint();
        setTimeout(() => map.invalidateSize(), 120);
      });
      return bar;
    },
  });
  map.addControl(new FsControl({ position: 'topleft' }));

  const layer = L.layerGroup().addTo(map);
  // Nearest-MRT walking route lives in its own layer so a re-compute can redraw it without
  // touching the comp pins. Ink, not green: green is reserved for positive market direction, so
  // a neutral path keeps the one red for the flat. Leaflet strokes SVG via the `stroke`
  // attribute (no CSS var), so read the ink token to a concrete string once.
  const routeLayer = L.layerGroup().addTo(map);
  const routeColor =
    getComputedStyle(document.documentElement).getPropertyValue('--ink').trim() || '#181410';
  // The flat marker (drawn in compute) is raised above the route so the line reads as starting at
  // the marker's edge, not from a dash inside the red dot.
  let flatMarker: L.CircleMarker | null = null;

  // Walking-reach rings (5/10/15 min ≈ 400/800/1200 m) sit under the pins in their own layer so a
  // re-compute redraws them cleanly. Read the editorial red to a concrete string (SVG stroke can't
  // resolve a CSS var); the rings are non-interactive so they never steal a pin's tooltip.
  const reachLayer = L.layerGroup().addTo(map);
  const redColor =
    getComputedStyle(document.documentElement).getPropertyValue('--red').trim() || '#fe012b';
  const REACH_RINGS: { meters: number; label: string; fill: number }[] = [
    { meters: 400, label: '5 min', fill: 0.05 },
    { meters: 800, label: '10 min', fill: 0.035 },
    { meters: 1200, label: '15 min', fill: 0.02 },
  ];
  // Rings around the flat, each labelled at its northern edge. Largest first so inner fills stack.
  function drawReachRings(center: [number, number]) {
    reachLayer.clearLayers();
    for (const ring of [...REACH_RINGS].reverse()) {
      L.circle(center, {
        radius: ring.meters,
        interactive: false,
        color: redColor,
        weight: 1,
        opacity: 0.4,
        dashArray: '3 5',
        fillColor: redColor,
        fillOpacity: ring.fill,
      }).addTo(reachLayer);
      // metres → degrees latitude (1° lat ≈ 111_320 m) places the label at the ring's top edge
      L.marker([center[0] + ring.meters / 111_320, center[1]], {
        interactive: false,
        keyboard: false,
        icon: L.divIcon({ className: 'reach-label', html: ring.label, iconSize: [46, 16] }),
      }).addTo(reachLayer);
    }
  }

  // MRT/LRT line colours keyed by code prefix. Used only to tint the single nearest-station
  // icon (never whole-map lines), so the map still reads as one red flat + one green route.
  const LINE_COLORS: Record<string, string> = {
    NS: '#d42e12',
    EW: '#009645',
    CG: '#009645',
    NE: '#9f4c9c',
    CC: '#f79500',
    CE: '#f79500',
    DT: '#0055b8',
    TE: '#9d5b25',
  };
  const lineColor = (codes: string) => {
    const prefix = codes.split(' / ')[0].replace(/\d.*$/, '');
    return LINE_COLORS[prefix] ?? '#5b544a'; // LRT / unknown → ink-2
  };
  // Human-readable line names keyed by code prefix, for the station card's nearby list.
  const LINE_NAMES: Record<string, string> = {
    NS: 'North-South Line',
    EW: 'East-West Line',
    CG: 'East-West Line',
    NE: 'North East Line',
    CC: 'Circle Line',
    CE: 'Circle Line',
    DT: 'Downtown Line',
    TE: 'Thomson-East Coast Line',
    BP: 'Bukit Panjang LRT',
    SE: 'Sengkang LRT',
    SW: 'Sengkang LRT',
    STC: 'Sengkang LRT',
    PE: 'Punggol LRT',
    PW: 'Punggol LRT',
    PTC: 'Punggol LRT',
  };
  // Line name(s) for a codes string ("CC15 / NS17" → "Circle Line · North-South Line"),
  // de-duplicated so an interchange on the same line doesn't repeat.
  const lineName = (codes: string) => {
    const names = codes
      .split(' / ')
      .map((c) => LINE_NAMES[c.replace(/\d.*$/, '')] ?? stationKind(c));
    return [...new Set(names)].join(' · ');
  };
  // One tinted rounded badge per code (interchanges get one badge per line, e.g. NS17 + CC15).
  const codeBadges = (codes: string) =>
    codes
      .split(' / ')
      .map((c) => `<span class="sc-badge" style="background:${lineColor(c)}">${c}</span>`)
      .join('');
  // A recognisable MRT station icon (train glyph) tinted by its line, in place of a plain dot.
  // The body is white; windows and wheels are cut in the line colour via currentColor.
  const mrtIcon = (codes: string) =>
    L.divIcon({
      className: 'mrt-pin',
      html:
        `<span class="mrt-badge" style="background:${lineColor(codes)};color:${lineColor(codes)}">` +
        '<svg viewBox="0 0 24 24" aria-hidden="true">' +
        '<rect x="6" y="3.5" width="12" height="11" rx="3" fill="#fff"/>' +
        '<rect x="7.6" y="5.6" width="3.2" height="2.6" rx="0.6" fill="currentColor"/>' +
        '<rect x="13.2" y="5.6" width="3.2" height="2.6" rx="0.6" fill="currentColor"/>' +
        '<circle cx="9.2" cy="11.4" r="1.05" fill="currentColor"/>' +
        '<circle cx="14.8" cy="11.4" r="1.05" fill="currentColor"/>' +
        '<path d="M8.4 14.5 6.8 17.4M15.6 14.5 17.2 17.4" stroke="#fff" stroke-width="1.5" stroke-linecap="round"/>' +
        '</svg></span>',
      iconSize: [22, 22],
      iconAnchor: [11, 11],
    });
  // Call a stop "LRT" only when every line code is an LRT prefix; interchanges that also
  // carry a heavy-rail code (e.g. Bukit Panjang BP6/DT1) read as "MRT".
  const LRT_PREFIXES = ['BP', 'STC', 'SW', 'SE', 'PTC', 'PW', 'PE'];
  const stationKind = (codes: string) =>
    codes.split(' / ').every((c) => LRT_PREFIXES.some((p) => c.startsWith(p))) ? 'LRT' : 'MRT';

  // Stations are loaded once (lazy) and cached; the nearest to the flat is picked client-side.
  let stations: Station[] | null = null;
  async function loadStations(): Promise<Station[]> {
    if (stations) return stations;
    stations = (await fetch(`${import.meta.env.BASE_URL}geo/mrt-stations.json`).then((r) =>
      r.json(),
    )) as Station[];
    return stations;
  }

  // Rail-line geometry (schematic, one LineString per line, tagged with its brand colour). Loaded
  // lazily like the stations; the map draws only the line(s) the nearest station sits on.
  let mrtLines: GeoJSON.FeatureCollection | null = null;
  async function loadLines(): Promise<GeoJSON.FeatureCollection> {
    if (mrtLines) return mrtLines;
    mrtLines = (await fetch(`${import.meta.env.BASE_URL}geo/mrt-lines.geojson`).then((r) =>
      r.json(),
    )) as GeoJSON.FeatureCollection;
    return mrtLines;
  }

  // ---- nearby amenities (hawker/food, supermarkets, malls) ----
  type Amenity = { type: string; name: string; lat: number; lng: number };
  // Category colours come from the chart palette (muted teal/amber/blue), never the brand red.
  const AMENITY_META: Record<string, { color: string; label: string; glyph: string }> = {
    hawker: {
      color: '#d98a2b',
      label: 'Food',
      glyph:
        '<path d="M5 11h14a7 7 0 0 1-14 0Z" fill="#fff"/>' +
        '<path d="M14 3.5 17 8.5" stroke="#fff" stroke-width="1.6" stroke-linecap="round"/>',
    },
    supermarket: {
      color: '#2f9e8f',
      label: 'Supermarkets',
      glyph:
        '<path d="M4 5h2l1.8 8.5h9L18.5 8H7" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>' +
        '<circle cx="9.5" cy="18" r="1.3" fill="#fff"/><circle cx="16" cy="18" r="1.3" fill="#fff"/>',
    },
    mall: {
      color: '#3b6ea5',
      label: 'Malls',
      glyph:
        '<path d="M6.5 8.5h11l-1 11h-9Z" fill="none" stroke="#fff" stroke-width="1.8" stroke-linejoin="round"/>' +
        '<path d="M9 8.5a3 3 0 0 1 6 0" fill="none" stroke="#fff" stroke-width="1.8"/>',
    },
  };
  // Amenities cluster: dense towns have 100+ food places within 1 km, so individual pins would be
  // soup. Cluster them (same pattern as Town Analysis) — counts collapse, pins expand on zoom, so
  // everything nearby is reachable rather than truncated to an arbitrary few.
  const amenityLayer = (L as any).markerClusterGroup({
    maxClusterRadius: 45,
    showCoverageOnHover: false,
    chunkedLoading: true,
  });
  amenityLayer.addTo(map);
  const shownCats = new Set<string>();
  // Food entries compile every eatery at a block into one point: `n` counts them and `names` lists
  // a few for the tooltip. Supermarkets/malls are single places (no n/names).
  type Place = { name: string; lat: number; lng: number; n?: number; names?: string[] };
  let amenities: Amenity[] | null = null;
  async function loadAmenities(): Promise<Amenity[]> {
    if (amenities) return amenities;
    amenities = (await fetch(`${import.meta.env.BASE_URL}geo/amenities.json`).then((r) =>
      r.json(),
    )) as Amenity[];
    return amenities;
  }
  // Food is a comprehensive SFA + NEA layer in its own file; supermarkets/malls stay in
  // amenities.json. Both reduce to {name, lat, lng} for drawing.
  let food: Place[] | null = null;
  async function loadFood(): Promise<Place[]> {
    if (food) return food;
    food = (await fetch(`${import.meta.env.BASE_URL}geo/food.json`).then((r) =>
      r.json(),
    )) as Place[];
    return food;
  }
  async function placesFor(cat: string): Promise<Place[]> {
    if (cat === 'hawker') return loadFood();
    return (await loadAmenities()).filter((a) => a.type === cat);
  }
  function amenityIcon(cat: string) {
    const m = AMENITY_META[cat];
    return L.divIcon({
      className: 'am-pin',
      html: `<span class="am-badge" style="background:${m.color}"><svg viewBox="0 0 24 24" aria-hidden="true">${m.glyph}</svg></span>`,
      iconSize: [18, 18],
      iconAnchor: [9, 9],
    });
  }
  // Draw the selected amenity categories near the flat — everything within a walkable ~800 m,
  // clustered so dense areas stay legible (no arbitrary cap, so nothing nearby is hidden).
  // `amenitySeq` drops results from a compute() that's since been superseded.
  const AMENITY_RADIUS = 800;
  let amenitySeq = 0;
  async function drawAmenities(from: [number, number]) {
    const seq = ++amenitySeq;
    amenityLayer.clearLayers();
    if (!shownCats.size) return;
    for (const cat of shownCats) {
      let source: Place[];
      try {
        source = await placesFor(cat);
      } catch {
        continue;
      }
      if (seq !== amenitySeq) return;
      const near = source
        .map((a) => ({ a, d: haversineMeters(from, [a.lat, a.lng]) }))
        .filter((x) => x.d <= AMENITY_RADIUS)
        .sort((x, y) => x.d - y.d);
      const label = AMENITY_META[cat].label;
      for (const { a, d } of near) {
        // Food pins compile a whole block: title with the count and list a few names.
        let title: string;
        if (a.n && a.n > 1) {
          const listed = (a.names ?? [a.name]).join(', ');
          const extra = a.n - (a.names?.length ?? 1);
          title = `<b>${a.n} eateries</b><br/>${listed}${extra > 0 ? `, +${extra} more` : ''}`;
        } else {
          title = `<b>${a.name}</b>`;
        }
        L.marker([a.lat, a.lng], { icon: amenityIcon(cat), keyboard: false })
          .bindTooltip(`${title}<br/>${label} · ${Math.round(d)} m`, {
            direction: 'top',
            offset: [0, -8],
            opacity: 1,
            className: 'hdb-tip',
          })
          .addTo(amenityLayer);
      }
    }
  }

  // Compact distance: metres under 1 km, else one-decimal km (mono figures downstream).
  const fmtDist = (m: number) => (m < 1000 ? `${Math.round(m)} m` : `${(m / 1000).toFixed(1)} km`);
  // Same split into a big figure + its unit, for the card's headline distance.
  const distParts = (m: number) =>
    m < 1000 ? { v: String(Math.round(m)), u: 'm' } : { v: (m / 1000).toFixed(1), u: 'km' };
  // Rough on-foot minutes at ~80 m/min, floored at 1.
  const walkMins = (m: number) => Math.max(1, Math.round(m / 80));

  // Fill the station card beneath the map: the nearest station as a headline (serif name, line
  // badges, big distance + walk time) and the next-nearest stations as a list. `nearest = null`
  // hides the whole card.
  function setStation(
    nearest: { station: Station; meters: number } | null,
    nearby: { station: Station; meters: number }[] = [],
  ) {
    const card = $('ins-walk');
    const modes = $('ins-amenities');
    if (!nearest) {
      card.setAttribute('hidden', '');
      modes.setAttribute('hidden', '');
      return;
    }
    card.removeAttribute('hidden');
    modes.removeAttribute('hidden');
    const dp = distParts(nearest.meters);
    $('sc-name').textContent = titleCase(nearest.station.name);
    $('sc-badges').innerHTML = codeBadges(nearest.station.codes);
    $('sc-dist').textContent = dp.v;
    $('sc-unit').textContent = dp.u;
    $('sc-walk').textContent = `approx ${walkMins(nearest.meters)} min walk`;
    $('sc-nearby-wrap').toggleAttribute('hidden', nearby.length === 0);
    $('sc-nearby').innerHTML = nearby
      .map(
        (n) =>
          `<li class="sc-row"><span class="sc-badges">${codeBadges(n.station.codes)}</span>` +
          `<div class="sc-row-main"><span class="sc-row-name">${titleCase(n.station.name)}</span>` +
          `<span class="sc-row-line">${lineName(n.station.codes)}</span></div>` +
          `<div class="sc-row-fig"><span class="sc-row-dist">${fmtDist(n.meters)}</span>` +
          `<span class="sc-row-min">~${walkMins(n.meters)} min</span></div></li>`,
      )
      .join('');
  }

  // Draw the nearest MRT and the straight-line distance to it (computed on-device from the
  // block's coordinates — nothing leaves the browser). `mrtSeq` drops results from a compute()
  // that's been superseded.
  let mrtSeq = 0;
  async function updateNearestMrt(from: [number, number]) {
    const seq = ++mrtSeq;
    routeLayer.clearLayers();
    drawReachRings(from); // synchronous, so draw before the async station load
    let list: Station[];
    try {
      list = await loadStations();
    } catch {
      setStation(null);
      return;
    }
    if (seq !== mrtSeq) return;
    // Pull the four closest so the nearby list can show three *other* stations beneath the
    // highlighted nearest, without repeating it.
    const nearby = nearbyStations(from[0], from[1], list, 4);
    const near = nearby[0];
    if (!near) {
      setStation(null);
      return;
    }
    const to: [number, number] = [near.station.lat, near.station.lng];
    const kind = stationKind(near.station.codes);

    // Draw the corridor(s) the nearest station sits on, under the marker + line. Best-effort:
    // the line geometry is optional, so a fetch miss just leaves the station on its own.
    const prefixes = new Set(near.station.codes.split(' / ').map((c) => c.replace(/\d.*$/, '')));
    try {
      const lines = await loadLines();
      if (seq !== mrtSeq) return;
      L.geoJSON(lines, {
        interactive: false,
        filter: (f) => prefixes.has(f.properties?.line),
        style: (f) => ({
          color: f?.properties?.color,
          weight: 3,
          opacity: 0.65,
          lineCap: 'round',
          lineJoin: 'round',
        }),
      }).addTo(routeLayer);
    } catch {
      /* line geometry unavailable — the station marker alone still reads */
    }

    L.marker(to, { icon: mrtIcon(near.station.codes), keyboard: false })
      .bindTooltip(`<b>${near.station.name} ${kind}</b><br/>${near.station.codes}`, {
        direction: 'top',
        offset: [0, -8],
        opacity: 1,
        className: 'hdb-tip',
      })
      .addTo(routeLayer);

    // Straight (as-the-crow-flies) dashed line from the flat to the nearest station.
    L.polyline([from, to], {
      color: routeColor,
      weight: 4,
      opacity: 0.9,
      lineCap: 'round',
      lineJoin: 'round',
      dashArray: '3 8',
    }).addTo(routeLayer);
    flatMarker?.bringToFront(); // hide the line's start under the red dot, not inside it

    setStation(near, nearby.slice(1));

    // Widen the view only if the station pokes outside the comps frame, to avoid a jump.
    const b = L.latLngBounds([from, to]);
    if (!map.getBounds().contains(b)) map.fitBounds(map.getBounds().extend(b), { maxZoom: 16 });
  }

  // The resolved line carries validation errors only — the matched block/town is shown
  // inline under the postal code, so a success message there would just be redundant.
  const resolveError = (msg: string) => {
    $('resolved').innerHTML = `<span class="pin">📍</span><span>${msg}</span>`;
  };

  // ---- resolve a postal code → block metadata + populate dependent fields ----
  async function resolveBlock() {
    const postal = parseInt(($('f-postal') as HTMLInputElement).value, 10);
    if (!postal || String(postal).length < 5) {
      resolveError('Enter a valid 6-digit postal code.');
      return false;
    }

    // Postal → block identity (arg_max latest / mode) + flat-type list, resolved in the worker.
    const meta = await qResolveBlock(postal);
    if (!meta) {
      resolveError('No transactions found for that postal code. Try another.');
      return false;
    }
    resolvedPostal = postal;
    block = {
      town: meta.town,
      street: meta.street,
      address: meta.address,
      model: meta.model,
      lc: meta.lc,
    };
    userLatLng = meta.lat != null ? [meta.lat, meta.lng as number] : null;
    const postalSub = $('f-postal-sub');
    postalSub.classList.remove('cue'); // resolved: drop the red "start here" prompt
    postalSub.textContent = `${titleCase(block.address)} · ${titleCase(block.town)}`;
    $('resolved').textContent = ''; // clear any prior error now that we've resolved
    // flat_model is already stored in its canonical mixed case (DBSS, Model A, Type S1,
    // 3Gen), so render it as-is — titleCase would lowercase acronyms like DBSS -> Dbss.
    $('f-model').textContent = block.model || '—';

    ($('f-flat') as HTMLSelectElement).innerHTML = meta.flats
      .map((f) => `<option>${f.flat_type}</option>`)
      .join('');
    await onFlatChange();
    return true;
  }

  async function onFlatChange() {
    const postal = parseInt(($('f-postal') as HTMLInputElement).value, 10);
    const flat = ($('f-flat') as HTMLSelectElement).value;
    $('f-flat-sub').textContent = block.model || '';

    const { storeys, areaMedian: areaMed } = await qStoreysArea(postal, flat);
    const sel = $('f-storey') as HTMLSelectElement;
    sel.innerHTML = storeys.map((s) => `<option>${s.storey_range}</option>`).join('');
    if (storeys.length) sel.selectedIndex = Math.floor(storeys.length / 2); // default mid-floor

    if (areaMed) {
      ($('f-area') as HTMLInputElement).value = String(Math.round(areaMed));
      $('f-area-sub').textContent = `≈ typical for this block`;
    }
    const rem = remainingLease();
    $('f-lease').textContent = rem ? `${rem} yr` : '—';
    $('f-lease-sub').textContent = block.lc ? `Commenced ${block.lc}` : 'From records';
  }

  // ================= render helpers for the new insight sections =================

  // 02 · price trajectory — median PSF by year for this town + flat type, with the
  // user's storey-adjusted estimate drawn as a reference line.
  function renderTrajectory(rows: any[], userPsf: number, flat: string, town: string) {
    const el = ec('traj-chart');
    if (!rows.length) {
      el.clear();
      return;
    }
    const first = rows[0],
      last = rows[rows.length - 1];
    const growth = first.psf ? (last.psf / first.psf - 1) * 100 : 0;
    $('traj-title').textContent = `Median PSF · ${titleCase(town)} ${flat.toLowerCase()}`;
    $('traj-hint').textContent =
      `Median PSF for ${flat.toLowerCase()} flats in ${titleCase(town)}, ${first.yr}–${last.yr}.`;
    const pill = $('traj-pill');
    const g = deltaPill(growth, { digits: 0 });
    pill.className = `pill ${g.cls}`;
    pill.textContent = `${g.text} since ${first.yr}`;
    el.setOption({
      ...baseOption(),
      grid: { left: 52, right: 18, top: 18, bottom: 30, containLabel: false },
      tooltip: { trigger: 'axis', valueFormatter: (v: number) => `${fpsf(v)} psf` },
      xAxis: {
        type: 'category',
        data: rows.map((r) => r.yr),
        axisLabel,
        axisLine,
        axisTick: { show: false },
      },
      yAxis: {
        type: 'value',
        scale: true,
        axisLabel: { ...axisLabel, formatter: (v: number) => '$' + v },
        splitLine,
      },
      series: [
        {
          type: 'line',
          smooth: true,
          symbol: 'circle',
          symbolSize: 6,
          data: rows.map((r) => Math.round(r.psf)),
          lineStyle: { width: 2.5, color: red },
          itemStyle: { color: red },
          areaStyle: { color: 'rgba(254,1,43,.07)' },
          markLine: userPsf
            ? {
                symbol: 'none',
                silent: true,
                lineStyle: { color: ink3, type: 'dashed' },
                data: [{ yAxis: Math.round(userPsf) }],
                label: {
                  formatter: `your est. ${fpsf(userPsf)}`,
                  color: ink3,
                  fontSize: 11,
                  position: 'insideStartTop',
                },
              }
            : undefined,
        },
      ],
    });
  }

  // Format the purchase-price field with thousands separators as the user types,
  // keeping the caret anchored to the same digit.
  function formatPaid() {
    const el = $('r-paid') as HTMLInputElement;
    const { value, caret } = reformatWithCaret(el.value, el.selectionStart ?? el.value.length);
    el.value = value;
    el.setSelectionRange(caret, caret);
  }

  function renderReturns() {
    const out = $('ret-out');
    const paid = parsePrice(($('r-paid') as HTMLInputElement).value);
    const yr = parseInt(($('r-year') as HTMLInputElement).value, 10);
    if (!paid || !yr || yr < 1990 || yr >= NOW_YEAR || !currentEstimate) {
      out.innerHTML = '<div class="ret-empty">Your appreciation will appear here.</div>';
      return;
    }
    const { hold, gain, totRet, cagr, townCagr, beat } = computeReturns(
      paid,
      yr,
      currentEstimate,
      NOW_YEAR,
      townYearPrice,
      latestYear,
    );
    const cls = gain >= 0 ? 'pos' : 'neg';
    const town = titleCase(block.town);
    out.innerHTML = `
      <div class="ret-big ${cls}">${gain >= 0 ? '+' : '−'}${money(Math.abs(gain))}</div>
      <div class="ret-sub">${totRet >= 0 ? '+' : '−'}${Math.abs(totRet).toFixed(0)}% since ${yr} · ${hold} year${hold > 1 ? 's' : ''} held</div>
      <div class="ret-rows">
        <div class="ret-row"><span class="k">Your return per year</span><span class="v">${cagr >= 0 ? '+' : '−'}${Math.abs(cagr).toFixed(1)}%/yr</span></div>
        ${
          isFinite(townCagr)
            ? `<div class="ret-row"><span class="k">${town} average</span><span class="v">${townCagr >= 0 ? '+' : '−'}${Math.abs(townCagr).toFixed(1)}%/yr</span></div>
        <div class="ret-row"><span class="k">You vs ${town}</span><span class="v" style="color:${beat >= 0 ? 'var(--good)' : 'var(--red-ink)'}">${beat >= 0 ? '▲' : '▼'} ${Math.abs(beat).toFixed(1)} pts/yr</span></div>`
            : ''
        }
      </div>`;
  }

  // 03 · distribution — histogram of comparable PSF with the user's estimate marked,
  // plus the percentile of comps it beats.
  function renderDistribution(psfs: number[], userPsf: number, flat: string, town: string) {
    const el = ec('dist-chart');
    if (psfs.length < 4) {
      el.clear();
      $('pctile-pill').textContent = '—';
      $('dist-cap').textContent = 'Too few sales to plot a distribution.';
      return;
    }
    const min = Math.min(...psfs),
      max = Math.max(...psfs);
    const nb = Math.min(16, Math.max(6, Math.round(Math.sqrt(psfs.length))));
    const w = (max - min) / nb || 1;
    const bins = new Array(nb).fill(0);
    const centers = Array.from({ length: nb }, (_, i) => min + w * (i + 0.5));
    psfs.forEach((p) => {
      bins[Math.min(nb - 1, Math.max(0, Math.floor((p - min) / w)))]++;
    });
    const userBin = Math.min(nb - 1, Math.max(0, Math.floor((userPsf - min) / w)));
    const pct = Math.round((psfs.filter((p) => p < userPsf).length / psfs.length) * 100);
    const pill = $('pctile-pill');
    pill.className = `pill ${pct >= 50 ? 'up' : 'flat'}`;
    pill.textContent = `${pct}th percentile`;
    $('dist-cap').textContent =
      `Your estimate (${fpsf(userPsf)}) is priced above ${pct}% of recent ${flat.toLowerCase()} sales in ${titleCase(town)}.`;
    el.setOption({
      ...baseOption(),
      grid: { left: 18, right: 14, top: 14, bottom: 26, containLabel: false },
      tooltip: {
        trigger: 'axis',
        formatter: (ps: any) => {
          const i = ps[0].dataIndex;
          return `${fpsf(centers[i] - w / 2)}–${fpsf(centers[i] + w / 2)} psf<br/><b>${bins[i]}</b> sales`;
        },
      },
      xAxis: {
        type: 'category',
        data: centers.map((c) => fpsf(c)),
        axisLabel: { ...axisLabel, interval: Math.ceil(nb / 6) - 1 },
        axisLine,
        axisTick: { show: false },
      },
      yAxis: { type: 'value', show: false },
      series: [
        {
          type: 'bar',
          barCategoryGap: '12%',
          data: bins.map((v, i) => ({
            value: v,
            itemStyle: { color: i === userBin ? red : '#d9cfbe', borderRadius: [3, 3, 0, 0] },
          })),
        },
      ],
    });
  }

  // 04 · lease decay — how PSF softens as the lease runs down (island-wide, same type).
  function renderLeaseCurve(rows: any[], userRem: number, townName: string | null) {
    const el = ec('lease-chart');
    $('leasecurve-sub').textContent = townName
      ? `Same flat type in ${townName}, last 36 months`
      : 'Same flat type, island-wide, last 24 months';
    if (rows.length < 2) {
      el.clear();
      return;
    }
    const userBucket = `${Math.floor(userRem / 10) * 10}y`;
    const cats = rows.map((r) => `${r.bucket}y`);
    el.setOption({
      ...baseOption(),
      grid: { left: 54, right: 18, top: 18, bottom: 44, containLabel: false },
      tooltip: { trigger: 'axis', valueFormatter: (v: number) => `${fpsf(v)} psf` },
      xAxis: {
        type: 'category',
        data: cats,
        axisLabel,
        axisLine,
        axisTick: { show: false },
        name: 'remaining lease',
        nameLocation: 'middle',
        nameGap: 30,
        nameTextStyle: { color: ink3, fontSize: 11 },
      },
      yAxis: {
        type: 'value',
        scale: true,
        axisLabel: { ...axisLabel, formatter: (v: number) => '$' + v },
        splitLine,
      },
      series: [
        {
          type: 'line',
          smooth: true,
          symbol: 'circle',
          symbolSize: 6,
          data: rows.map((r) => Math.round(r.psf)),
          lineStyle: { width: 2.5, color: palette[4] },
          itemStyle: { color: palette[4] },
          areaStyle: { color: 'rgba(59,110,165,.07)' },
          markLine: cats.includes(userBucket)
            ? {
                symbol: 'none',
                silent: true,
                lineStyle: { color: red, type: 'dashed' },
                data: [{ xAxis: userBucket }],
                label: { formatter: 'your flat', color: red, fontSize: 11 },
              }
            : undefined,
        },
      ],
    });
  }

  // 04 · CPF / financing thresholds keyed off remaining lease (informational).
  function renderLeaseFlags(rem: number) {
    const flags = [
      {
        at: 60,
        k: 'Full CPF & HDB loan',
        ok: 'Available at your lease',
        warn: 'Restricted below 60 yrs',
      },
      {
        at: 30,
        k: 'Bank loan tenure',
        ok: 'Longer tenures possible',
        warn: 'Tighter below 30 yrs',
      },
      { at: 20, k: 'CPF usage floor', ok: 'CPF can be used', warn: 'Blocked below 20 yrs' },
    ];
    $('lease-flags').innerHTML = flags
      .map((f) => {
        const ok = rem >= f.at;
        const yrsTo = rem - f.at;
        return `<div class="lease-flag ${ok ? '' : 'warn'}">
        <span class="lf-k">${f.k}</span>
        <span class="lf-v">${ok ? `${f.ok} · <b>${yrsTo}</b> yrs of headroom` : f.warn}</span></div>`;
      })
      .join('');
  }

  // ---- compute valuation + benchmarks + comparables ----
  async function compute() {
    const flat = ($('f-flat') as HTMLSelectElement).value;
    const storey = ($('f-storey') as HTMLSelectElement).value;
    const area = Number(($('f-area') as HTMLInputElement).value) || 0;
    const rem = remainingLease();
    if (!block.town || !flat || !area) return;

    // One worker round-trip returns everything this valuation needs from the dataset: comps
    // (same town+flat, 12mo → widened to 24 if thin), island medians, the yearly trajectory,
    // and the lease-decay buckets. All the shaping below stays on the (cheap) main thread.
    const { comps, months, island, trajectory, leaseTown, leaseIsland } = await qValuation({
      town: block.town,
      flat,
    });
    const islandPsf = island.psf,
      islandPrice = island.price,
      islandArea = island.area;

    // valuation — base median PSF over all comps, then adjust for the chosen storey band
    const baseMedPsf = med(comps.map((c) => c.psf));
    const userLo = parseInt(storey, 10) || 0; // "10 TO 12" -> 10
    const nearStorey = comps.filter((c) => Math.abs(c.slo - userLo) <= 3);
    const useStorey = nearStorey.length >= 5; // only adjust when the band has enough sales
    const basis = useStorey ? nearStorey : comps;
    const psfs = basis.map((c) => c.psf).sort((a, b) => a - b);
    const medPsf = med(psfs),
      q25 = quantile(psfs, 0.25),
      q75 = quantile(psfs, 0.75);
    const storeyAdjPct = baseMedPsf ? (medPsf / baseMedPsf - 1) * 100 : 0;
    const estimate = medPsf * area,
      low = q25 * area,
      high = q75 * area;
    currentEstimate = estimate;
    const n = comps.length;
    const nb = basis.length;
    const [confLabel, confBars] =
      nb >= 30 ? ['High', 4] : nb >= 15 ? ['Medium-High', 3] : nb >= 5 ? ['Medium', 2] : ['Low', 1];

    $('val-hint').textContent = useStorey
      ? `Modelled from ${nb} comparable ${flat.toLowerCase()} sales on similar storeys (${storey}) in ${titleCase(block.town)}, last ${months} months.`
      : `Modelled from ${n} comparable ${flat.toLowerCase()} sales in ${titleCase(block.town)}, last ${months} months.`;
    $('val-big').textContent = money(estimate);
    $('val-low').textContent = money(low);
    $('val-high').textContent = money(high);
    $('scale-low').textContent = moneyShort(low);
    $('scale-high').textContent = moneyShort(high);
    const pos =
      high > low ? Math.min(92, Math.max(8, ((estimate - low) / (high - low)) * 100)) : 50;
    ($('val-marker') as HTMLElement).style.left = pos + '%';
    $('vs-n').textContent = String(n);
    $('vs-psf').textContent = fpsf(baseMedPsf);
    $('vs-area').textContent = `${area.toLocaleString()} sqft`;
    $('vs-storey').textContent = useStorey
      ? `${storeyAdjPct >= 0 ? '+' : ''}${storeyAdjPct.toFixed(1)}% · ${storey}`
      : 'n/a, too few';
    $('conf-label').textContent = confLabel;
    $('conf-bars').innerHTML = [0, 1, 2, 3]
      .map((i) => `<i class="${i < confBars ? 'on' : ''}"></i>`)
      .join('');

    // benchmarks
    const townPrice = med(comps.map((c) => c.price)),
      townArea = med(comps.map((c) => c.area));
    const bar = (
      rows: { lab: string; val: number; you?: boolean; fmt: (n: number) => string }[],
    ) => {
      const max = Math.max(...rows.map((r) => r.val), 1);
      return rows
        .map(
          (r) =>
            `<div class="row"><span class="lab">${r.lab}</span><span class="bar"><span class="${r.you ? 'you' : 'ctx'}" style="width:${Math.round((r.val / max) * 100)}%"></span></span><span class="amt">${r.fmt(r.val)}</span></div>`,
        )
        .join('');
    };
    const dPsf = islandPsf ? (medPsf / islandPsf - 1) * 100 : 0;
    const psfPill = deltaPill(dPsf, { threshold: 1 });
    $('b1-v').textContent = fpsf(medPsf);
    $('b1-pill').className = `pill ${psfPill.cls}`;
    $('b1-pill').textContent = `${psfPill.text} vs island`;
    $('b1-bars').innerHTML = bar([
      { lab: 'This flat', val: medPsf, you: true, fmt: fpsf },
      { lab: 'Island', val: islandPsf, fmt: fpsf },
    ]);

    const dPrice = townPrice ? (estimate / townPrice - 1) * 100 : 0;
    const pricePill = deltaPill(dPrice, { threshold: 1 });
    $('b2-v').textContent = moneyShort(estimate);
    $('b2-pill').className = `pill ${pricePill.cls}`;
    $('b2-pill').textContent = `${pricePill.text} vs town`;
    $('b2-bars').innerHTML = bar([
      { lab: 'This flat', val: estimate, you: true, fmt: moneyShort },
      { lab: `${titleCase(block.town)}`, val: townPrice, fmt: moneyShort },
      { lab: 'Island', val: islandPrice, fmt: moneyShort },
    ]);

    const dArea = townArea ? (area / townArea - 1) * 100 : 0;
    const areaPill = deltaPill(dArea, { threshold: 1, digits: 0 });
    $('b3-v').textContent = `${area.toLocaleString()} sqft`;
    $('b3-pill').className = `pill ${Math.abs(dArea) < 3 ? 'flat' : areaPill.cls}`;
    $('b3-pill').textContent =
      Math.abs(dArea) < 3 ? '≈ typical for type' : `${areaPill.text} vs town`;
    $('b3-bars').innerHTML = bar([
      { lab: 'This flat', val: area, you: true, fmt: (v) => v.toLocaleString() },
      {
        lab: `${titleCase(block.town)}`,
        val: townArea,
        fmt: (v) => Math.round(v).toLocaleString(),
      },
      { lab: 'Island', val: islandArea, fmt: (v) => Math.round(v).toLocaleString() },
    ]);

    // lease decay
    $('lease-rem').textContent = String(rem);
    $('lease-start').textContent = block.lc ? String(block.lc) : '—';
    const nowEl = $('lease-now') as HTMLElement;
    nowEl.style.left = `${((99 - rem) / 99) * 100}%`;
    nowEl.setAttribute('data-label', `${rem} yrs left`);

    // comparables table (same street first, then recency)
    const sameStreet = (c: any) => c.street_name === block.street;
    const sorted = [...comps].sort(
      (a, b) => Number(sameStreet(b)) - Number(sameStreet(a)) || b.month.localeCompare(a.month),
    );
    const youRow = `<tr class="you"><td class="addr" data-role="title"><b>${titleCase(block.address)}</b><span class="badge">YOUR FLAT</span><br><span class="st">Estimated</span></td>
      <td data-role="meta">${storey}</td><td class="r" data-role="meta" data-suffix="sqft">${area.toLocaleString()}</td><td class="r" data-role="meta">${rem} yr</td>
      <td class="r price" data-role="primary">${money(estimate)}</td><td class="r psf" data-role="meta" data-suffix="psf">${fpsf(medPsf)}</td><td class="r" data-role="meta">—</td><td class="tbreak" aria-hidden="true"></td></tr>`;
    const rows = sorted
      .slice(0, 8)
      .map(
        (
          c,
        ) => `<tr><td class="addr" data-role="title"><b>${titleCase(c.address)}</b><br><span class="st">${titleCase(c.street_name)}</span></td>
      <td data-role="meta">${c.storey_range}</td><td class="r" data-role="meta" data-suffix="sqft">${c.area.toLocaleString()}</td><td class="r" data-role="meta">${c.lease} yr</td>
      <td class="r price" data-role="primary">${money(c.price)}</td><td class="r psf" data-role="meta" data-suffix="psf">${fpsf(c.psf)}</td><td class="r" data-role="meta">${c.month}</td><td class="tbreak" aria-hidden="true"></td></tr>`,
      )
      .join('');
    $('comp-body').innerHTML = youRow + rows;
    $('comp-foot').textContent =
      `Showing ${Math.min(8, comps.length)} of ${comps.length} comparable sales · last ${months} months · ${titleCase(block.town)}`;

    // ---- new insight sections: trajectory, distribution, market tiles, lease, storey ----
    // 03 · distribution + market texture tiles (derived from comps already fetched)
    renderDistribution(
      comps.map((c) => c.psf),
      medPsf,
      flat,
      block.town,
    );
    const perMonth = comps.length / months;
    $('mt-vel').textContent = comps.length.toLocaleString();
    $('mt-vel-s').textContent =
      `${flat.toLowerCase()} in ${titleCase(block.town)} · ~${perMonth.toFixed(1)}/mo`;
    const byPrice = [...comps].sort((a, b) => b.price - a.price);
    const hiC = byPrice[0],
      loC = byPrice[byPrice.length - 1];
    if (hiC) {
      $('mt-hi').textContent = moneyShort(hiC.price);
      $('mt-hi-s').textContent = `${titleCase(hiC.address)} · ${hiC.month}`;
    }
    if (loC) {
      $('mt-lo').textContent = moneyShort(loC.price);
      $('mt-lo-s').textContent = `${titleCase(loC.address)} · ${loC.month}`;
    }

    // 04 · lease thresholds (client-side, from remaining lease)
    renderLeaseFlags(rem);

    // 02/04 · trajectory + lease-decay curves came from the same worker round-trip above
    // (they need wider history than the comps window).
    const traj = trajectory;
    townYearPrice = {};
    traj.forEach((r) => {
      townYearPrice[r.yr] = r.price;
    });
    latestYear = traj.length ? traj[traj.length - 1].yr : '';
    renderTrajectory(traj, medPsf, flat, block.town);
    renderReturns(); // reflects the refreshed estimate + town series
    // prefer the user's own town for the lease curve; fall back to island-wide when too thin
    const leaseInTown = leaseTown.length >= 2;
    const leaseRows = leaseInTown ? leaseTown : leaseIsland;
    renderLeaseCurve(
      leaseRows.map((r) => ({ bucket: r.bucket, psf: r.psf })),
      rem,
      leaseInTown ? titleCase(block.town) : null,
    );

    // map: comps (grey) + your block (red)
    layer.clearLayers();
    const pts: [number, number][] = [];
    comps.forEach((c) => {
      if (c.lat == null || c.lng == null) return;
      pts.push([c.lat, c.lng]);
      L.circleMarker([c.lat, c.lng], {
        radius: 6,
        weight: 1.5,
        color: '#fff',
        fillColor: '#c9bfae',
        fillOpacity: 0.9,
      })
        .bindTooltip(
          `<b>${titleCase(c.address)}</b><br/>${c.month} · ${c.storey_range}<br/><b>${money(c.price)}</b> · ${fpsf(c.psf)} psf`,
          { direction: 'top', offset: [0, -6], opacity: 1, className: 'hdb-tip' },
        )
        .addTo(layer);
    });
    if (userLatLng) {
      pts.push(userLatLng);
      flatMarker = L.circleMarker(userLatLng, {
        radius: 9,
        weight: 2.5,
        color: '#fff',
        fillColor: '#fe012b',
        fillOpacity: 1,
      })
        .bindTooltip(
          `<b>Your flat</b> · ${titleCase(block.address)}<br/><b>${money(estimate)}</b> est · ${fpsf(medPsf)} psf`,
          { direction: 'top', offset: [0, -8], opacity: 1, className: 'hdb-tip' },
        )
        .addTo(layer);
    }
    // Default the view to the 10-minute walking ring (800 m) around the flat, so "what's a short
    // walk away" fills the frame. Fall back to the comps bounds when we have no flat location.
    const tenMinM = REACH_RINGS[1]?.meters ?? 800;
    if (userLatLng) {
      map.fitBounds(L.latLng(userLatLng[0], userLatLng[1]).toBounds(2 * tenMinM));
    } else if (pts.length) {
      map.fitBounds(L.latLngBounds(pts).pad(0.15));
    }
    setTimeout(() => map.invalidateSize(), 50);
    // Nearest-MRT walking route (async; extends the frame only if the station sits outside it).
    if (userLatLng) {
      updateNearestMrt(userLatLng);
      drawAmenities(userLatLng);
    } else {
      routeLayer.clearLayers();
      reachLayer.clearLayers();
      amenityLayer.clearLayers();
      setStation(null);
    }

    // Export state: keep the comps for the CSV, refresh the print summary, and track the
    // computed view in the URL so copy-link / bookmarks reproduce it.
    currentComps = comps;
    fillPrintSummary({ flat, storey, area, rem, estimate, low, high, medPsf, townPrice, months });
    url.sync();
  }

  // Populate the hidden one-page print summary from a finished compute().
  function fillPrintSummary(d: {
    flat: string;
    storey: string;
    area: number;
    rem: number;
    estimate: number;
    low: number;
    high: number;
    medPsf: number;
    townPrice: number;
    months: number;
  }) {
    $('ps-sub').textContent =
      `${titleCase(block.address)} · ${titleCase(block.town)} · ${titleCase(d.flat)} · ` +
      `${d.area.toLocaleString()} sqft` +
      (block.lc ? ` · lease from ${block.lc}` : '');
    $('ps-est').textContent = money(d.estimate);
    $('ps-rng').textContent =
      `Likely range ${moneyShort(d.low)} – ${moneyShort(d.high)} · based on ` +
      `${currentComps.length} comparable sale${currentComps.length === 1 ? '' : 's'} in the last ${d.months} months`;
    const topComps = [...currentComps].sort((a, b) => b.month.localeCompare(a.month)).slice(0, 5);
    $('ps-comps').innerHTML = topComps
      .map(
        (c) =>
          `<div class="ps-row"><span>${titleCase(c.address)} · storey ${c.storey_range} · ${c.month}</span><span class="mono">${money(c.price)}</span></div>`,
      )
      .join('');
    $('ps-bench').innerHTML =
      `<div class="ps-bench-row"><span>Town median (${titleCase(d.flat)})</span><span class="mono">${money(d.townPrice)}</span></div>` +
      `<div class="ps-bench-row"><span>Median PSF</span><span class="mono">${fpsf(d.medPsf)}</span></div>`;
    $('ps-foot').textContent =
      `Estimate only, not a formal valuation. Generated ${new Date().toLocaleDateString('en-SG', {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
      })}.`;
  }

  // ---- wiring ----
  ($('f-postal') as HTMLInputElement).addEventListener('change', async () => {
    if (await resolveBlock()) compute();
  });
  $('f-flat').addEventListener('change', async () => {
    await onFlatChange();
    compute();
  });
  ['f-storey', 'f-area'].forEach((id) => $(id).addEventListener('change', compute));
  // Amenity category chips: each toggles its layer of nearby hawker/food, supermarket, or mall
  // pins. Independent (multi-select); toggling only redraws the amenity layer, no re-valuation.
  $('ins-amenities')
    .querySelectorAll<HTMLButtonElement>('.am-chip')
    .forEach((btn) =>
      btn.addEventListener('click', () => {
        const cat = btn.dataset.cat as string;
        const on = !shownCats.has(cat);
        if (on) shownCats.add(cat);
        else shownCats.delete(cat);
        btn.classList.toggle('on', on);
        btn.setAttribute('aria-pressed', String(on));
        if (userLatLng) drawAmenities(userLatLng);
      }),
    );
  // Returns panel recomputes locally from the current estimate — no worker round-trip.
  $('r-paid').addEventListener('input', () => {
    formatPaid();
    renderReturns();
  });
  $('r-year').addEventListener('input', renderReturns);
  $('get-insights').addEventListener('click', async () => {
    const cur = parseInt(($('f-postal') as HTMLInputElement).value, 10);
    // re-resolve only if the postal changed (avoid clobbering the user's edited fields)
    if (cur !== resolvedPostal) {
      if (!(await resolveBlock())) return;
    }
    await compute();
    document.querySelector('.results')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  // ---- export toolbar ----
  $('copy-link').addEventListener('click', async () => {
    url.sync(); // make sure the URL reflects the current computed view before copying
    const link = location.href;
    try {
      await navigator.clipboard.writeText(link);
    } catch {
      // Older Safari / non-secure contexts: fall back to a hidden textarea + execCommand.
      const ta = document.createElement('textarea');
      ta.value = link;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      try {
        document.execCommand('copy');
      } catch {
        /* nothing else to try */
      }
      document.body.removeChild(ta);
    }
    const toast = $('copy-toast');
    toast.classList.add('show');
    setTimeout(() => toast.classList.remove('show'), 2500);
  });

  $('dl-comps').addEventListener('click', () => {
    if (!currentComps.length) return;
    downloadCsv(
      'my-flat-comps.csv',
      ['month', 'address', 'street_name', 'storey_range', 'area', 'lease', 'price', 'psf'],
      currentComps.map((c) => [
        c.month,
        c.address,
        c.street_name,
        c.storey_range,
        c.area,
        c.lease,
        c.price,
        Math.round(c.psf),
      ]),
    );
  });

  $('print-btn').addEventListener('click', () => window.print());

  // ---- deep-link restore ----
  // No postal param → the page stays inert (no DuckDB boot), preserving the JS-free-ish
  // cold load. resolveBlock()/onFlatChange() auto-overwrite storey/area every run, so
  // URL overrides for those are applied strictly AFTER the last onFlatChange().
  async function restoreFromUrl() {
    const params = new URLSearchParams(location.search);
    const postal = params.get('postal');
    if (!postal) return;
    ($('f-postal') as HTMLInputElement).value = postal;
    if (!(await resolveBlock())) return; // populates f-flat + runs onFlatChange
    const flat = params.get('flat');
    if (flat) {
      const sel = $('f-flat') as HTMLSelectElement;
      if ([...sel.options].some((o) => o.value === flat)) {
        sel.value = flat;
        await onFlatChange();
      }
    }
    // Apply the storey/area overrides last (unknown values are graceful no-op sets).
    const storey = params.get('storey');
    if (storey) ($('f-storey') as HTMLSelectElement).value = storey;
    const area = params.get('area');
    if (area) ($('f-area') as HTMLInputElement).value = area;
    await compute();
    document.querySelector('.results')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  restoreFromUrl();

  window.addEventListener('resize', () => {
    map.invalidateSize();
    Object.values(charts).forEach((c) => c.resize());
  });
</script>
