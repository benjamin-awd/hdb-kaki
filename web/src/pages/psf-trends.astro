---
import Base from '../layouts/Base.astro';
import Info from '../components/Info.astro';
import Term from '../components/Term.astro';
import SecHead from '../components/SecHead.astro';
import ChartCard from '../components/ChartCard.astro';
import FieldSelect from '../components/FieldSelect.astro';
import DataTable from '../components/DataTable.astro';
---

<Base active="PSF Trends" title="PSF Trends | HDB Kaki">
  <!-- The default view paints from a precomputed JSON snapshot (psf-trends.json), so no
       data engine is on the load path — the worker is warmed on idle and only queried when
       the visitor changes a filter or zooms. -->
  <section class="hero">
    <div class="wrap">
      <span class="eyebrow rise"><span class="dot"></span> Price per Square Foot</span>
      <h1 class="title rise" style="animation-delay:.05s">
        The PSF story,<br /><em>street by street</em>.
      </h1>
      <p class="lede solo rise" style="animation-delay:.1s">
        Fit a trend to price-per-square-foot over time for any town, street or storey band.
      </p>
    </div>
  </section>

  <main class="wrap pagepad">
    <div class="controls" style="margin:8px 0 22px">
      <FieldSelect label="Town" id="sel-town" />
      <FieldSelect label="Street" id="sel-street" />
      <FieldSelect label="Storey" id="sel-storey">
        <option value="all" selected>All</option>
        <option value="1-6">01–06</option>
        <option value="7-12">07–12</option>
        <option value="13-99">13+</option>
      </FieldSelect>
      <div class="chipset" id="reg-toggle">
        <button class="chip on" data-reg="ols">OLS</button>
        <button class="chip" data-reg="loess">LOWESS</button>
      </div>
      <Info label="What do OLS and LOWESS mean?">
        <strong>OLS</strong> (Ordinary Least Squares) fits a single straight line — the best overall direction
        of prices over time. <strong>LOWESS</strong> is a flexible curve that follows local ups and downs,
        so it can show bends a straight line misses.
      </Info>
    </div>

    <div class="bench-grid">
      <div class="card bench">
        <div class="bk">Current month</div><div class="bv mono" id="stat-month">—</div><div
          class="bsub"
        >
          latest registered data
        </div>
      </div>
      <div class="card bench">
        <div class="bk">Current PSF (trend)</div><div class="bv mono" id="stat-psf">—</div><div
          class="bsub"
          id="stat-delta"
        >
          &nbsp;
        </div>
      </div>
      <div class="card bench">
        <div class="bk">
          Fit quality · <Term term="R²" end
            >How well the trend line fits the data, from 0 to 1 — higher means less scatter around
            the line.</Term
          >
        </div><div class="bv mono" id="stat-r2">—</div><div class="bsub" id="stat-fit">&nbsp;</div>
      </div>
    </div>

    <SecHead num="01" title="PSF over time">
      Each dot is a transaction (sampled); the line is the fitted trend on monthly medians.
    </SecHead>
    <ChartCard title="Price per sqft" titleId="chart-title">
      <div id="scatter-note" slot="head" style="font-size:12.5px;color:var(--ink-3)"></div>
      <div id="chart-psf" style="width:100%;height:420px"></div>
    </ChartCard>

    <SecHead num="02" title="Fitted PSF by month">
      Trend value read off the fit for each month.
    </SecHead>
    <div class="card table-card">
      <DataTable
        headers={[
          { label: 'Month' },
          { label: 'Trend PSF', align: 'r' },
          {
            label: 'MoM change',
            align: 'r',
            tip: '<strong>Month-on-month</strong>: the change in trend PSF from the previous month.',
          },
        ]}
        bodyId="tbody-psf"
      />
      <div class="tbl-foot"><span id="psf-foot">&nbsp;</span></div>
    </div>
  </main>
</Base>

<style>
  #chart-psf {
    min-height: 420px;
  }
</style>

<script>
  import { initChart } from '../lib/echarts';
  import { regressionLinear, regressionLoess } from 'd3-regression';
  // The default view renders from a precomputed snapshot (psf-trends.json); filter changes
  // and zoom resamples run against resale.parquet held in a Web Worker (hyparquet). The
  // scatter sample + monthly medians are computed in the worker and only those summaries
  // cross back. The worker is warmed at idle so the first change is snappy.
  import {
    baseOption,
    axisLabel,
    splitLine,
    axisLine,
    ink2,
    line as lineCol,
    red,
  } from '../lib/echartsTheme';
  import { money, psf as fpsf, titleCase, deltaPill } from '../lib/format';
  import { byId as $, setStreets } from '../lib/dom';
  import { createHyparquet } from '../lib/hyparquetClient';
  import type { PsfSpec, ScatterRow, Monthly } from '../lib/hyparquetClient';

  const { psfScatter, streets, warmWhenIdle } = createHyparquet();

  const START = '2020-01';

  const SCATTER_CAP = 6000; // reservoir-sample the dots above this; stats/trend use the full set
  const idxOf = (m: string) => (+m.slice(0, 4) - 2017) * 12 + (+m.slice(5, 7) - 1);
  const dateOf = (idx: number) => new Date(2017 + Math.floor(idx / 12), idx % 12, 1).getTime();
  const monthLabel = (idx: number) =>
    `${2017 + Math.floor(idx / 12)}-${String((idx % 12) + 1).padStart(2, '0')}`;

  const chart = initChart($('chart-psf'));
  let regType: 'ols' | 'loess' = 'ols';
  let fullMinIdx = 0,
    fullMaxIdx = 0; // full x-extent, for mapping zoom % → months
  let zoomTimer: ReturnType<typeof setTimeout>;

  const toScatter = (rows: ScatterRow[]) =>
    rows.map((r) => ({
      value: [dateOf(idxOf(r.month)), Number(r.psf)],
      address: r.address,
      month: r.month,
      storey: r.storey,
      price: Number(r.price),
      psf: Number(r.psf),
      lease: Number(r.lease),
    }));
  const noteText = (total: number, suffix = '') =>
    (total > SCATTER_CAP
      ? `random sample of ${SCATTER_CAP.toLocaleString()} of ${total.toLocaleString()}`
      : `all ${total.toLocaleString()}`) + ` transactions${suffix}`;
  if (import.meta.env.DEV) {
    (window as any).__psfTip = (i: number) =>
      chart.dispatchAction({ type: 'showTip', seriesIndex: 0, dataIndex: i });
    (window as any).__psfLineTip = (i: number) =>
      chart.dispatchAction({ type: 'showTip', seriesIndex: 2, dataIndex: i });
    (window as any).__psfZoom = (s: number, e: number) =>
      chart.dispatchAction({ type: 'dataZoom', start: s, end: e });
  }

  // A serializable slice spec built from the current filters — crosses to the worker (no
  // closures). Mirrors the old SQL WHERE: this town, since START, psf present, plus optional
  // street + storey band. The zoom resample just overrides monthFrom/monthTo.
  function specFromUI(): PsfSpec {
    const storey = ($('sel-storey') as HTMLSelectElement).value;
    let storeyLo: number | null = null,
      storeyHi: number | null = null;
    if (storey !== 'all') {
      const [a, b] = storey.split('-').map(Number);
      storeyLo = a;
      storeyHi = b;
    }
    return {
      town: ($('sel-town') as HTMLSelectElement).value,
      street: ($('sel-street') as HTMLSelectElement).value,
      storeyLo,
      storeyHi,
      monthFrom: START,
      cap: SCATTER_CAP,
    };
  }

  let curSample: ScatterRow[] = [];
  let curMonthly: Monthly[] = [];

  // Ask the worker for the current filter's scatter sample + per-month medians, then paint.
  async function loadRender() {
    const { sample, monthly } = await psfScatter(specFromUI());
    paintChart(sample, monthly);
  }

  // Render the chart, stats and table from already-fetched data. Pure client-side, so
  // toggling the regression type re-fits the same data without a new query.
  function paintChart(sample: ScatterRow[], monthly: Monthly[]) {
    curSample = sample;
    curMonthly = monthly;

    const title =
      `Price per sqft · ${titleCase(($('sel-town') as HTMLSelectElement).value)}` +
      (($('sel-street') as HTMLSelectElement).value !== '__all'
        ? ` · ${titleCase(($('sel-street') as HTMLSelectElement).value)}`
        : '');
    $('chart-title').textContent = title;

    const totalTx = monthly.reduce((s, r) => s + Number(r.n), 0);
    $('scatter-note').textContent = noteText(totalTx);

    const pts = monthly.map((r) => ({ idx: idxOf(r.month), med: Number(r.med), month: r.month }));
    // fitted value per month index
    const fitted = new Map<number, number>();
    let r2 = NaN;
    if (pts.length >= 2) {
      if (regType === 'ols') {
        const reg = regressionLinear()
          .x((d: any) => d.idx)
          .y((d: any) => d.med);
        const line = reg(pts as any);
        r2 = (line as any).rSquared;
        pts.forEach((p) => fitted.set(p.idx, (line as any).predict(p.idx)));
      } else {
        const reg = regressionLoess()
          .x((d: any) => d.idx)
          .y((d: any) => d.med)
          .bandwidth(0.35);
        const smooth = reg(pts as any) as [number, number][];
        smooth.forEach(([x, y]) => fitted.set(x, y));
        // generic R² on monthly medians
        const mean = pts.reduce((s, p) => s + p.med, 0) / pts.length;
        let ssRes = 0,
          ssTot = 0;
        pts.forEach((p) => {
          const f = fitted.get(p.idx) ?? p.med;
          ssRes += (p.med - f) ** 2;
          ssTot += (p.med - mean) ** 2;
        });
        r2 = ssTot ? 1 - ssRes / ssTot : NaN;
      }
    }

    if (pts.length) {
      fullMinIdx = pts[0].idx;
      fullMaxIdx = pts[pts.length - 1].idx;
    }
    const lineData = pts.map((p) => [dateOf(p.idx), Math.round(fitted.get(p.idx) ?? p.med)]);
    const scatterData = toScatter(sample);

    chart.setOption(
      {
        ...baseOption(),
        legend: {
          top: 0,
          right: 0,
          textStyle: { fontSize: 12 },
          data: ['Transactions', regType === 'ols' ? 'OLS trend' : 'LOWESS trend'],
        },
        grid: { left: 60, right: 24, top: 40, bottom: 70, containLabel: false },
        dataZoom: [
          { type: 'inside' },
          {
            type: 'slider',
            height: 18,
            bottom: 16,
            borderColor: lineCol,
            showDataShadow: false,
            fillerColor: 'rgba(254,1,43,.10)',
            handleStyle: { color: red },
            moveHandleStyle: { color: red },
            textStyle: { color: ink2, fontSize: 10 },
          },
        ],
        tooltip: {
          trigger: 'item',
          backgroundColor: '#fffdf8',
          borderColor: lineCol,
          borderWidth: 1,
          textStyle: { color: '#181410', fontSize: 13 },
          extraCssText: 'box-shadow:0 12px 30px -18px rgba(24,20,16,.35);border-radius:10px',
          formatter: (p: any) => {
            if (p.seriesName === 'Transactions') {
              const d = p.data;
              return `<b>${titleCase(d.address)}</b><br/>${d.month} · ${d.storey}<br/><b>${money(d.price)}</b> · ${fpsf(d.psf)} psf · ${d.lease} yrs left`;
            }
            const dt = new Date(p.value[0]);
            const ml = `${dt.getFullYear()}-${String(dt.getMonth() + 1).padStart(2, '0')}`;
            return `${ml}<br/><b>${fpsf(p.value[1])}</b> fitted trend`;
          },
        },
        xAxis: { type: 'time', axisLabel, axisLine, splitLine: { show: false } },
        yAxis: {
          type: 'value',
          scale: true,
          axisLabel: { ...axisLabel, formatter: (v: number) => fpsf(v) },
          splitLine,
        },
        series: [
          {
            name: 'Transactions',
            type: 'scatter',
            symbolSize: 7,
            itemStyle: { color: ink2, opacity: 0.42, borderColor: '#fffdf8', borderWidth: 0.5 },
            data: scatterData,
            z: 1,
          },
          {
            name: regType === 'ols' ? 'OLS trend' : 'LOWESS trend',
            type: 'line',
            smooth: regType === 'loess',
            showSymbol: false,
            lineStyle: { color: red, width: 3 },
            itemStyle: { color: red },
            emphasis: { disabled: true },
            data: lineData,
            z: 3,
          },
          {
            // invisible hover layer: gives the clean line a hoverable hit area for the
            // fitted-value tooltip — no dot, no highlight animation. Not shown in the legend.
            name: '_trendhover',
            type: 'scatter',
            data: lineData,
            symbolSize: 22,
            itemStyle: { color: red, opacity: 0 },
            emphasis: { disabled: true },
            z: 4,
          },
        ],
      },
      true,
    );

    // stat tiles
    if (pts.length) {
      const last = pts[pts.length - 1],
        prev = pts[pts.length - 2];
      const lastF = fitted.get(last.idx) ?? last.med;
      $('stat-month').textContent = last.month;
      $('stat-psf').textContent = fpsf(lastF);
      if (prev) {
        const prevF = fitted.get(prev.idx) ?? prev.med;
        const { cls, text } = deltaPill(((lastF - prevF) / prevF) * 100, { threshold: 0.5 });
        $('stat-delta').innerHTML = `<span class="pill ${cls}">${text}</span> vs last month`;
      }
      $('stat-r2').textContent = isNaN(r2) ? '—' : r2.toFixed(2);
      $('stat-fit').textContent = isNaN(r2)
        ? ''
        : r2 > 0.75
          ? 'strong fit'
          : r2 > 0.4
            ? 'moderate fit'
            : 'weak fit';
    }

    // table (latest 8, desc)
    const desc = [...pts].reverse();
    $('tbody-psf').innerHTML = desc
      .slice(0, 8)
      .map((p, i) => {
        const f = fitted.get(p.idx) ?? p.med;
        const nxt = desc[i + 1];
        let mom = '';
        if (nxt) {
          const fn = fitted.get(nxt.idx) ?? nxt.med;
          const { cls, text } = deltaPill(((f - fn) / fn) * 100, { threshold: 0.5 });
          mom = `<span class="pill ${cls}">${text}</span>`;
        }
        return `<tr><td class="num-cell">${p.month}</td><td class="r price">${fpsf(f)}</td><td class="r">${mom}</td></tr>`;
      })
      .join('');
    $('psf-foot').textContent = `Showing ${Math.min(8, pts.length)} of ${pts.length} months`;
  }

  document.querySelectorAll<HTMLButtonElement>('#reg-toggle .chip').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('#reg-toggle .chip').forEach((b) => b.classList.remove('on'));
      btn.classList.add('on');
      regType = btn.dataset.reg as 'ols' | 'loess';
      // Re-fit the data we already have — no query needed to switch OLS/LOWESS.
      paintChart(curSample, curMonthly);
    });
  });

  // ---- boot: paint the default view from the precomputed snapshot, then wire filters ----
  type Snapshot = {
    default: { town: string };
    towns: string[];
    streets: string[];
    sample: ScatterRow[];
    monthly: Monthly[];
  };
  (async () => {
    const data: Snapshot = await fetch(`${import.meta.env.BASE_URL}data/psf-trends.json`).then(
      (r) => {
        if (!r.ok) throw new Error(`psf-trends.json ${r.status}`);
        return r.json();
      },
    );
    ($('sel-town') as HTMLSelectElement).innerHTML = data.towns
      .map((t) => `<option${t === data.default.town ? ' selected' : ''}>${t}</option>`)
      .join('');
    setStreets($('sel-street'), data.streets);

    // Paint immediately from JSON — no parquet needed for the default view.
    paintChart(data.sample, data.monthly);

    // Filters (and the semantic-zoom resample) read the in-memory parquet rows.
    $('sel-town').addEventListener('change', async () => {
      setStreets($('sel-street'), await streets(($('sel-town') as HTMLSelectElement).value));
      loadRender();
    });
    $('sel-street').addEventListener('change', loadRender);
    $('sel-storey').addEventListener('change', loadRender);

    // Warm the worker at idle so the first filter/zoom is instant.
    // Save-Data / idle / prerender gated inside warmWhenIdle().
    warmWhenIdle();
  })();

  // semantic zoom: re-sample the scatter to the visible date window so zooming in reveals more detail
  async function resampleForZoom() {
    const dz = (chart.getOption().dataZoom as any[] | undefined)?.[0];
    if (!dz || fullMaxIdx <= fullMinIdx) return;
    const startPct = dz.start ?? 0,
      endPct = dz.end ?? 100;
    if (startPct <= 0.5 && endPct >= 99.5) {
      // back to full range — restore the full-range sample + note
      loadRender();
      return;
    }
    const span = fullMaxIdx - fullMinIdx;
    const a = monthLabel(Math.floor(fullMinIdx + (span * startPct) / 100));
    const b = monthLabel(Math.ceil(fullMinIdx + (span * endPct) / 100));
    const { sample, total } = await psfScatter({ ...specFromUI(), monthFrom: a, monthTo: b });
    chart.setOption({ series: [{ data: toScatter(sample) }] });
    $('scatter-note').textContent = noteText(total, ' in view');
  }
  chart.on('datazoom', () => {
    clearTimeout(zoomTimer);
    zoomTimer = setTimeout(resampleForZoom, 350);
  });

  window.addEventListener('resize', () => chart.resize());
</script>
