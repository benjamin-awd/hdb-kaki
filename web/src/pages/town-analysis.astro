---
import Base from '../layouts/Base.astro';
import Term from '../components/Term.astro';
import SecHead from '../components/SecHead.astro';
import ChartCard from '../components/ChartCard.astro';
import FieldSelect from '../components/FieldSelect.astro';
import Pager from '../components/Pager.astro';
import DataTable from '../components/DataTable.astro';
import LeafletMap from '../components/LeafletMap.astro';
---

<Base active="Town Analysis" title="Town Analysis | HDB Kaki">
  <!-- The default view paints from a precomputed JSON snapshot (town-analysis.json), so no
       data engine is on the load path — the worker is warmed on idle and only queried
       when the visitor changes a filter. -->
  <section class="hero">
    <div class="wrap">
      <span class="eyebrow rise"><span class="dot"></span> Explore by Town</span>
      <h1 class="title rise" style="animation-delay:.05s">Every sale, <em>mapped</em>.</h1>
      <p class="lede solo rise" style="animation-delay:.1s">
        Map every recent transaction in a town, banded low / mid / high against its own median.
      </p>
    </div>
  </section>

  <main class="wrap pagepad">
    <!-- 01 · PRICE MAP -->
    <SecHead num="01" title="Price map" rise>
      Each pin is a sale in the last 24 months, coloured relative to the town median.
    </SecHead>

    <div class="controls" style="margin-bottom:16px">
      <FieldSelect label="Town" id="sel-town" />
      <FieldSelect label="Subtown" id="sel-sub" />
      <FieldSelect label="Street" id="sel-street" />
      <FieldSelect label="Flat type" id="sel-flat" />
      <FieldSelect label="Threshold" id="sel-thr">
        <option value="0.05">±5%</option>
        <option value="0.1" selected>±10%</option>
        <option value="0.15">±15%</option>
      </FieldSelect>
    </div>

    <div class="split" style="grid-template-columns:1.55fr 1fr">
      <LeafletMap id="map" height="472px" />
      <div class="card" style="padding:24px">
        <div class="cap">
          <Term term="Median" end
            >The middle price — half of sales are higher, half lower. Unlike the average, a few
            extreme sales don't skew it.</Term
          > resale price
        </div>
        <div style="display:flex;align-items:baseline;gap:10px;margin-bottom:4px">
          <span
            id="median-price"
            style="font-family:var(--font-newsreader);font-weight:600;font-size:38px;letter-spacing:-.02em"
            >—</span
          >
        </div>
        <div id="map-sub" style="font-size:13px;color:var(--ink-3);margin-bottom:22px">&nbsp;</div>
        <div style="height:1px;background:var(--line);margin:6px 0 18px"></div>
        <div class="cap" style="margin-bottom:8px">
          <Term term="Distribution" end
            >Each sale vs the median: <strong>Around</strong> is within your threshold (e.g. ±10%);
            <strong>Above</strong> and <strong>Below</strong> fall outside.</Term
          >
        </div>
        <div class="cat-line">
          <span class="dot" style="background:var(--red)"></span>Above median<span class="bar"
            ><span id="bar-above" style="background:var(--red)"></span></span
          ><span class="amt" id="amt-above">—</span>
        </div>
        <div class="cat-line">
          <span class="dot" style="background:#d98a2b"></span>Around median<span class="bar"
            ><span id="bar-around" style="background:#d98a2b"></span></span
          ><span class="amt" id="amt-around">—</span>
        </div>
        <div class="cat-line">
          <span class="dot" style="background:var(--good)"></span>Below median<span class="bar"
            ><span id="bar-below" style="background:var(--good)"></span></span
          ><span class="amt" id="amt-below">—</span>
        </div>
      </div>
    </div>

    <!-- 02 · RECORD SALES -->
    <SecHead num="02" title="Record sales">
      The most expensive sales on record: a town's own peaks, or the record per town across
      Singapore. These are outliers (big units, high floors, prime blocks) shown with context, not
      typical prices.
    </SecHead>
    <div class="controls" style="margin-bottom:16px">
      <div class="chipset" id="record-scope">
        <button class="chip on" data-scope="town">This town</button>
        <button class="chip" data-scope="global">All Singapore</button>
      </div>
    </div>
    <ChartCard title="Most expensive on record" titleId="record-title">
      <div class="chart-sub" slot="head">
        Ranked by peak transaction · median for that flat type shown for scale
      </div>
      <div class="lead" id="record-list"></div>
      <div class="rec-foot">
        <span id="record-foot">&nbsp;</span>
        <Pager />
      </div>
    </ChartCard>

    <!-- 03 · DATA TABLE -->
    <SecHead num="03" title="Data behind the map"> Every point currently in view. </SecHead>
    <div class="card table-card">
      <DataTable
        headers={[
          { label: 'Sold' },
          { label: 'Address' },
          { label: 'Price', align: 'r' },
          {
            label: 'PSF',
            align: 'r',
            tip: '<strong>Price per square foot</strong> — sale price ÷ floor area, so different-sized flats compare fairly.',
          },
          { label: 'Lease left', align: 'r' },
          { label: 'Band' },
        ]}
        bodyId="tbody-town"
        stack
      />
      <div class="tbl-foot">
        <span id="town-foot">&nbsp;</span>
        <Pager prevId="tbl-prev" nextId="tbl-next" />
      </div>
    </div>
    <!-- Download sits below the card as a quiet link: the paged footer is the pager, and the
         wording makes clear it exports every sale in view, not just the current page. -->
    <a class="dl-below" href="#" id="dl-town">Download all sales (CSV) ↓</a>
  </main>
</Base>

<style>
  /* Quiet "download the whole set" link under the data-table card (the footer holds the pager). */
  .dl-below {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 14px;
    font-size: 13px;
    font-weight: 600;
    color: var(--ink-3);
    text-decoration: none;
    border-bottom: 1px dashed var(--line);
    padding-bottom: 1px;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }
  .dl-below:hover {
    color: var(--red-ink);
    border-color: var(--red-ink);
  }
  .cap {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .cat-line {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 14px 0;
    font-size: 13.5px;
  }
  .cat-line .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex: none;
  }
  .cat-line .bar {
    flex: 1;
    height: 8px;
    border-radius: 999px;
    background: #efeadf;
    overflow: hidden;
  }
  .cat-line .bar span {
    display: block;
    height: 100%;
    width: 0;
  }
  .cat-line .amt {
    width: 52px;
    text-align: right;
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--ink-2);
  }
  /* record sales leaderboard (section 02). Rows are injected via innerHTML, so the
     .rec rules are :global — Astro's scoping only tags elements present in the template. */
  .chart-sub {
    font-size: 12.5px;
    color: var(--ink-3);
    margin-top: 3px;
  }
  .lead {
    display: grid;
    gap: 10px;
    margin-top: 16px;
  }
  :global(.rec) {
    display: grid;
    grid-template-columns: 26px 150px 1fr auto;
    align-items: center;
    gap: 14px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--paper);
    padding: 12px 16px;
  }
  /* Rows that deep-link into My Flat Insights render as anchors; strip link chrome and
     add a hover lift so the whole row reads as clickable. */
  :global(a.rec) {
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }
  :global(a.rec:hover) {
    border-color: var(--red-ink);
    box-shadow: var(--shadow);
  }
  /* Address deep-link inside the data table: inherit the cell's colour, reveal red-ink
     underline on hover so it reads as clickable without shouting in the dense table. */
  :global(.addr-link) {
    color: inherit;
    text-decoration: none;
  }
  :global(.addr-link:hover) {
    color: var(--red-ink);
    text-decoration: underline;
  }
  :global(.rec .rank) {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    color: var(--red-ink);
  }
  :global(.rec .town) {
    font-weight: 600;
    font-size: 14.5px;
  }
  :global(.rec .ctx) {
    font-size: 12.5px;
    color: var(--ink-3);
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  :global(.rec .ctx .ftype) {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--red-ink);
    background: var(--red-wash);
    padding: 2px 7px;
    border-radius: 999px;
    margin-right: 9px;
    vertical-align: 1px;
  }
  :global(.rec .price) {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 16px;
    letter-spacing: -0.01em;
    text-align: right;
    white-space: nowrap;
  }
  :global(.rec .price small) {
    display: block;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 11px;
    color: var(--ink-3);
    letter-spacing: 0;
  }
  /* Rank-1 headline row. Named .top (not .hero) so it doesn't inherit the page
     hero section's padding (.hero{padding:52px…}) and balloon in height. */
  :global(.rec.top) {
    background: linear-gradient(180deg, var(--paper-2), var(--red-wash));
  }
  @media (max-width: 640px) {
    :global(.rec) {
      grid-template-columns: 22px 1fr auto;
      row-gap: 4px;
    }
    :global(.rec .ctx) {
      grid-column: 2 / -1;
      white-space: normal;
    }
  }
  /* Record-sales footer holding the <Pager>. The negative side margins bleed the
     divider to the card edges past .chart-card's padding. */
  .rec-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin: 18px -24px 0;
    padding: 16px 24px 0;
    border-top: 1px solid var(--line);
    font-size: 13px;
    color: var(--ink-3);
  }
</style>

<script>
  import 'leaflet/dist/leaflet.css';
  import 'leaflet.markercluster/dist/MarkerCluster.css';
  import 'leaflet.markercluster/dist/MarkerCluster.Default.css';
  import L from 'leaflet';
  import 'leaflet.markercluster';
  // The default view renders from a precomputed snapshot (town-analysis.json); no data
  // engine is needed for first paint. Filters query the hyparquet data worker (resale.parquet
  // decoded once, off the main thread, warmed at idle). Map/records filtering and the record
  // medians run in the worker.
  import { money, moneyShort, psf as fpsf, titleCase } from '../lib/format';
  import { byId as $, setStreets } from '../lib/dom';
  import { createHyparquet } from '../lib/hyparquetClient';
  import { createUrlState, selectBinding, chipBinding, stateBinding } from '../lib/urlState';
  import { downloadCsv } from '../lib/csv';
  import { areaToTown } from '../lib/subzones';

  const { townMap, townRecords, streets, warmWhenIdle } = createHyparquet();

  const DEFAULT_TOWN = 'ANG MO KIO';
  const DEFAULT_FLAT = '4 ROOM';
  const BAND_COLOR: Record<string, string> = {
    above: '#fe012b',
    around: '#d98a2b',
    below: '#1f7a4d',
  };

  type Row = {
    lat: number;
    lng: number;
    price: number;
    address: string;
    month: string;
    storey: string;
    psf: number;
    lease: number;
    postal: number;
    band?: string;
  };
  type Rec = {
    town: string;
    price: number;
    address: string;
    storey: string;
    area: number;
    month: string;
    med: number;
    flat: string;
    psf: number;
    postal: number;
  };
  let currentRows: Row[] = [];
  let currentTown = DEFAULT_TOWN;
  let currentFlat = DEFAULT_FLAT;
  let currentSub: string | undefined;

  // ---- subtown (URA subzone) drill-down ----
  // The parquet carries no subzone column, so the subtown filter is applied client-side by
  // point-in-polygon against sg-subzones.geojson. Subzones group under their HDB town by the
  // planning `area`, with the same central/Kallang roll-ups the overview map uses (see areaToTown).
  const SUB_ALL = '__all';
  const subzonesByTown = new Map<string, string[]>();
  const subzoneGeom = new Map<string, any>();

  async function loadSubzones(towns: string[]) {
    const townSet = new Set(towns);
    const g = await fetch(`${import.meta.env.BASE_URL}geo/sg-subzones.geojson`).then((r) =>
      r.json(),
    );
    for (const f of g.features ?? []) {
      const name = f.properties?.name?.trim();
      const area = f.properties?.area?.trim();
      if (!name || !area) continue;
      const town = areaToTown(area, townSet);
      if (!town || !townSet.has(town)) continue;
      subzoneGeom.set(name, f.geometry);
      (subzonesByTown.get(town) ?? subzonesByTown.set(town, []).get(town)!).push(name);
    }
    for (const list of subzonesByTown.values()) list.sort();
  }

  // Populate the subtown picker with only the subzones that actually have sales for the
  // current town+flat. A subtown listed purely because its polygon sits in the town (e.g.
  // Yio Chu Kang for a rare flat type like Multi-Generation) would otherwise select to a
  // blank map. Independent of the street/subtown filters, so the list reflects the whole
  // town+flat slice; pass `rows` to reuse an already-fetched slice (boot) instead of querying.
  async function refreshSubtowns(town: string, flat: string, rows?: Row[]) {
    const all = subzonesByTown.get(town) ?? [];
    const src = rows ?? (await townMap({ town, flat, street: '__all' }));
    const withData = all.filter((s) => {
      const geom = subzoneGeom.get(s);
      return !!geom && src.some((r) => pointInGeom(r.lng, r.lat, geom));
    });
    const sel = $('sel-sub') as HTMLSelectElement;
    const prev = sel.value;
    sel.innerHTML =
      `<option value="${SUB_ALL}">All subtowns</option>` +
      withData.map((s) => `<option value="${s}">${titleCase(s)}</option>`).join('');
    // Keep the current pick if it still has data; otherwise fall back to "All subtowns".
    sel.value = withData.includes(prev) ? prev : SUB_ALL;
  }

  // Ray-casting point-in-polygon; even-odd across rings handles holes, and MultiPolygon tests
  // each member. Coordinates are [lng, lat], matching the geojson.
  function pointInRing(x: number, y: number, ring: number[][]): boolean {
    let inside = false;
    for (let i = 0, j = ring.length - 1; i < ring.length; j = i++) {
      const xi = ring[i][0],
        yi = ring[i][1],
        xj = ring[j][0],
        yj = ring[j][1];
      if (yi > y !== yj > y && x < ((xj - xi) * (y - yi)) / (yj - yi) + xi) inside = !inside;
    }
    return inside;
  }
  function pointInPolygon(x: number, y: number, rings: number[][][]): boolean {
    let inside = false;
    for (const ring of rings) if (pointInRing(x, y, ring)) inside = !inside;
    return inside;
  }
  function pointInGeom(lng: number, lat: number, geom: any): boolean {
    if (!geom) return false;
    if (geom.type === 'Polygon') return pointInPolygon(lng, lat, geom.coordinates);
    if (geom.type === 'MultiPolygon')
      return geom.coordinates.some((p: number[][][]) => pointInPolygon(lng, lat, p));
    return false;
  }
  function geomBounds(geom: any): any {
    const pts: [number, number][] = [];
    const polys = geom.type === 'MultiPolygon' ? geom.coordinates : [geom.coordinates];
    for (const poly of polys)
      for (const ring of poly) for (const [lng, lat] of ring) pts.push([lat, lng]);
    return pts.length ? L.latLngBounds(pts) : null;
  }

  // ---- Leaflet map (created once) ----
  const map = L.map('map', { scrollWheelZoom: false, attributionControl: true }).setView(
    [1.3521, 103.8198],
    12,
  );
  L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
    attribution: '© OpenStreetMap © CARTO',
    maxZoom: 19,
    subdomains: 'abcd',
  }).addTo(map);
  const cluster = (L as any).markerClusterGroup({ maxClusterRadius: 45, chunkedLoading: true });
  map.addLayer(cluster);

  // Pin tooltips open upward (direction:'top'). The rounded map has overflow:hidden
  // (needed to clip the tile layer), so a tooltip on a pin near the top edge gets
  // clipped. Leaflet tooltips can't autoPan/keepInView and only flip horizontally, so
  // on open we measure and flip vertically (top<->bottom) if the tooltip spills past an
  // edge. We never pan the map, so the hovered pin stays under the cursor — panning it
  // away would fire mouseout and flicker the tooltip shut.
  const TIP_GAP = 6;
  map.on('tooltipopen', (e: any) => {
    const tip = e.tooltip;
    const el: HTMLElement | null = tip.getElement();
    if (!el) return;
    const mapBox = map.getContainer().getBoundingClientRect();
    const box = el.getBoundingClientRect();
    let dir = tip.options.direction;
    if (box.top < mapBox.top) dir = 'bottom';
    else if (box.bottom > mapBox.bottom) dir = 'top';
    if (dir !== tip.options.direction) {
      tip.options.direction = dir;
      tip.options.offset = [0, dir === 'bottom' ? TIP_GAP : -TIP_GAP];
      tip.update(); // re-runs _setPosition: repositions + swaps the arrow class
    }
  });

  function median(nums: number[]): number {
    if (!nums.length) return 0;
    const s = [...nums].sort((a, b) => a - b);
    const m = Math.floor(s.length / 2);
    return s.length % 2 ? s[m] : (s[m - 1] + s[m]) / 2;
  }

  // Paint the map + summary + table from already-fetched rows. Pure client-side, so
  // changing only the threshold re-bands the same rows without a new query.
  function paintMap(rows: Row[], town: string, flat: string, sub?: string, focus?: any) {
    currentRows = rows;
    currentTown = town;
    currentFlat = flat;
    currentSub = sub;
    const thr = parseFloat(($('sel-thr') as HTMLSelectElement).value);

    const med = median(rows.map((r) => r.price));
    const lo = med * (1 - thr),
      hi = med * (1 + thr);
    for (const r of rows) r.band = r.price < lo ? 'below' : r.price > hi ? 'above' : 'around';

    // markers
    cluster.clearLayers();
    for (const r of rows) {
      L.circleMarker([r.lat, r.lng], {
        radius: 6,
        weight: 1.5,
        color: '#fff',
        fillColor: BAND_COLOR[r.band!],
        fillOpacity: 0.9,
      })
        .bindTooltip(
          `<b>${titleCase(r.address)}</b><br/>${r.month} · ${r.storey}<br/><b>${money(r.price)}</b> · ${fpsf(r.psf)} psf · ${r.lease} yrs left`,
          { direction: 'top', offset: [0, -6], opacity: 1, className: 'hdb-tip' },
        )
        .addTo(cluster);
    }
    // Recompute the container size before fitting: if the map div was mis-sized when this paint
    // ran (initial layout, tab switch), fitBounds would compute the wrong view and never correct.
    map.invalidateSize();
    // Focus the subtown polygon when one is picked (stable even with few/no pins); otherwise
    // frame the town's pins.
    if (focus) {
      map.fitBounds(focus.pad(0.08));
    } else if (rows.length) {
      const b = L.latLngBounds(rows.map((r) => [r.lat, r.lng] as [number, number]));
      // Reserve pixel room around the pins so upward-opening tooltips (direction:'top')
      // aren't clipped by the map's rounded, overflow-hidden container — extra at the
      // top since the tooltip stacks above its pin.
      map.fitBounds(b, { paddingTopLeft: [28, 92], paddingBottomRight: [28, 28] });
    }
    setTimeout(() => map.invalidateSize(), 50);

    // summary
    const counts = { above: 0, around: 0, below: 0 } as Record<string, number>;
    rows.forEach((r) => counts[r.band!]++);
    const max = Math.max(1, ...Object.values(counts));
    $('median-price').textContent = med ? money(med) : '—';
    $('map-sub').textContent =
      `${titleCase(town)}${sub ? ' · ' + titleCase(sub) : ''} · ${titleCase(flat)} · ${rows.length.toLocaleString()} sales (last 24 mo)`;
    (['above', 'around', 'below'] as const).forEach((k) => {
      ($('bar-' + k) as HTMLElement).style.width = (counts[k] / max) * 100 + '%';
      $('amt-' + k).textContent = counts[k].toLocaleString();
    });

    // table — one page at a time (see renderTownTable + the Prev/Next pager).
    renderTownTable();
  }

  // Data table below the map. A town+flat's 24-month slice can run to hundreds of rows, so it's
  // paged 12 at a time with the shared <Pager> (mirrors the landing page's Recent transactions);
  // the whole set is already in currentRows, so paging is pure client-side slicing. Row HTML is
  // per-row (no adjacency), so slicing is enough.
  const TOWN_PAGE = 12;
  let townPage = 0;
  function renderTownTable() {
    const rows = currentRows;
    const flat = currentFlat;
    const total = rows.length;
    const pages = Math.max(1, Math.ceil(total / TOWN_PAGE));
    if (townPage >= pages) townPage = pages - 1; // clamp when a smaller result set lands
    const start = total ? townPage * TOWN_PAGE : 0;
    const end = Math.min(start + TOWN_PAGE, total);
    $('tbody-town').innerHTML = rows
      .slice(start, end)
      .map((r) => {
        const pill = r.band === 'below' ? 'up' : r.band === 'above' ? 'down' : 'flat';
        const lbl = r.band![0].toUpperCase() + r.band!.slice(1);
        // Deep-link the address into My Flat Insights, pre-filled with this flat (postal +
        // the page's current flat type + this sale's storey band). Plain text when the row
        // lacks a postal to resolve the block from.
        const addr = titleCase(r.address);
        const addrCell = r.postal
          ? `<a class="addr-link" href="/my-flat-insights?${new URLSearchParams({ postal: String(r.postal), flat, storey: r.storey })}">${addr}</a>`
          : addr;
        return `<tr><td class="num-cell" data-role="meta">${r.month}</td><td data-role="title">${addrCell}</td>
        <td class="r price" data-role="primary">${money(r.price)}</td><td class="r num-cell" data-role="meta" data-suffix="psf">${fpsf(r.psf)}</td>
        <td class="r num-cell" data-role="meta">${r.lease} yrs</td><td data-role="meta"><span class="pill ${pill}">${lbl}</span></td><td class="tbreak" aria-hidden="true"></td></tr>`;
      })
      .join('');
    $('town-foot').textContent = total
      ? `Showing ${(start + 1).toLocaleString()}–${end.toLocaleString()} of ${total.toLocaleString()} sales in view`
      : 'No sales in view';
    ($('tbl-prev') as HTMLButtonElement).disabled = townPage === 0;
    ($('tbl-next') as HTMLButtonElement).disabled = end >= total;
    // The download grabs the whole result set, not just this page — say so.
    $('dl-town').textContent = `Download all ${total.toLocaleString()} sales (CSV) ↓`;
  }

  // Fetch rows for the current town/flat from the in-memory parquet, then paint. Mirrors
  // the SQL the default snapshot was precomputed from (see webapp/update/emit_web.py).
  async function loadMap() {
    const town = ($('sel-town') as HTMLSelectElement).value || DEFAULT_TOWN;
    const flat = ($('sel-flat') as HTMLSelectElement).value;
    const street = ($('sel-street') as HTMLSelectElement).value;
    const sub = ($('sel-sub') as HTMLSelectElement).value;
    // The worker scans its resident rows and returns the (bounded) town+flat slice already
    // coerced to numbers, in month DESC, resale_price DESC order.
    let rows = await townMap({ town, flat, street });
    // Subtown filter: keep only sales that fall inside the picked subzone polygon, and frame
    // the map to that subzone (see paintMap's `focus`).
    const geom = sub && sub !== SUB_ALL ? subzoneGeom.get(sub) : null;
    if (geom) rows = rows.filter((r) => pointInGeom(r.lng, r.lat, geom));
    // Fresh query → jump back to the first page (a threshold-only re-band calls paintMap
    // directly and keeps the current page).
    townPage = 0;
    paintMap(rows, town, flat, geom ? sub : undefined, geom ? geomBounds(geom) : null);
  }

  // ---- record sales (paged, town-scoped or Singapore-wide) ----
  // Two scopes, switched by the #record-scope toggle:
  //   'town'   — the selected town's own top sales on record (fits the town-centric page).
  //   'global' — the single highest sale per town, ranked across Singapore (national context).
  // Both span every flat type and show the median for that same flat type beside each row,
  // so the outlier reads as a headline against a like-for-like typical. Paged like the
  // landing page's Recent-transactions table.
  type RecordScope = 'town' | 'global';
  const RECORDS_PAGE_SIZE = 8; // keep in sync with RECORDS_PAGE_SIZE in webapp/update/emit_web.py
  let recordScope: RecordScope = 'town';
  let recordPage = 0;
  let recordTotal = 0;
  let recordReq = 0; // guards against out-of-order responses when paging quickly

  function paintRecords(input: Rec[]) {
    const townMode = recordScope === 'town';
    const town = ($('sel-town') as HTMLSelectElement).value || DEFAULT_TOWN;
    $('record-title').textContent = townMode
      ? `Most expensive in ${titleCase(town)}`
      : 'Most expensive per town · Singapore';
    $('record-list').innerHTML = input
      .map((r, i) => {
        const rank = recordPage * RECORDS_PAGE_SIZE + i + 1;
        // In town mode every row shares the same town, so lead with the flat type; in
        // global mode the town is the identifier and the flat type rides a badge in ctx.
        const lead = townMode ? titleCase(r.flat) : titleCase(r.town);
        const badge = townMode ? '' : `<span class="ftype">${r.flat}</span>`;
        const cls = `rec${rank === 1 ? ' top' : ''}`;
        const inner = `
        <span class="rank">${rank}</span>
        <span class="town">${lead}</span>
        <span class="ctx">${badge}${titleCase(r.address)} · storey ${r.storey.toLowerCase()} · ${Math.round(r.area).toLocaleString()} sqft · ${fpsf(r.psf)} psf · sold ${r.month}</span>
        <span class="price">${moneyShort(r.price)}<small>${titleCase(r.flat)} median ${moneyShort(r.med)}</small></span>`;
        // Deep-link the row to My Flat Insights, pre-filled with this exact flat. Fall back to
        // a plain row when the record lacks a postal (nothing to resolve the block from).
        if (!r.postal) return `<div class="${cls}">${inner}</div>`;
        const q = new URLSearchParams({
          postal: String(r.postal),
          flat: r.flat,
          storey: r.storey,
          area: String(Math.round(r.area)),
        });
        return `<a class="${cls}" href="/my-flat-insights?${q}">${inner}</a>`;
      })
      .join('');
    const noun = townMode ? 'sales' : 'towns';
    const start = input.length ? recordPage * RECORDS_PAGE_SIZE + 1 : 0;
    const end = recordPage * RECORDS_PAGE_SIZE + input.length;
    $('record-foot').textContent = recordTotal
      ? `Showing ${start}–${end} of ${recordTotal.toLocaleString()} ${noun}`
      : 'No records';
    ($('rec-prev') as HTMLButtonElement).disabled = recordPage === 0;
    ($('rec-next') as HTMLButtonElement).disabled = end >= recordTotal;
  }

  async function loadRecords() {
    const token = ++recordReq;
    const town = ($('sel-town') as HTMLSelectElement).value || DEFAULT_TOWN;
    try {
      // The worker ranks records (town or peak-per-town), joins the per-(town,flat) median,
      // and returns just this page plus the total.
      const { rows, total } = await townRecords({
        town,
        scope: recordScope,
        page: recordPage,
        pageSize: RECORDS_PAGE_SIZE,
      });
      if (token !== recordReq) return; // a newer request superseded this one
      recordTotal = total;
      paintRecords(rows);
    } catch (e) {
      console.error(e);
      if (token === recordReq) $('record-foot').textContent = 'Could not load records.';
    }
  }

  // ---- data-table pager (client-side: the whole result set is already in currentRows) ----
  $('tbl-prev').addEventListener('click', () => {
    if (townPage > 0) {
      townPage--;
      renderTownTable();
    }
  });
  $('tbl-next').addEventListener('click', () => {
    if ((townPage + 1) * TOWN_PAGE < currentRows.length) {
      townPage++;
      renderTownTable();
    }
  });

  // ---- CSV download (always the full result set in view, not just the current page) ----
  $('dl-town').addEventListener('click', (e) => {
    e.preventDefault();
    downloadCsv(
      'town-analysis.csv',
      ['month', 'address', 'price', 'psf', 'remaining_lease_years', 'band'],
      currentRows.map((r) => [r.month, r.address, r.price, r.psf.toFixed(0), r.lease, r.band]),
    );
  });

  // ---- boot: paint the default view from the precomputed snapshot, then wire filters ----
  type Snapshot = {
    default: { town: string; flat: string };
    towns: string[];
    flatTypes: string[];
    streets: string[];
    rows: Row[];
    records: Rec[];
    recordsTotal: number;
  };
  (async () => {
    const data: Snapshot = await fetch(`${import.meta.env.BASE_URL}data/town-analysis.json`).then(
      (r) => {
        if (!r.ok) throw new Error(`town-analysis.json ${r.status}`);
        return r.json();
      },
    );
    ($('sel-town') as HTMLSelectElement).innerHTML = data.towns
      .map((t) => `<option${t === data.default.town ? ' selected' : ''}>${t}</option>`)
      .join('');
    ($('sel-flat') as HTMLSelectElement).innerHTML = data.flatTypes
      .map((f) => `<option${f === data.default.flat ? ' selected' : ''}>${f}</option>`)
      .join('');
    setStreets($('sel-street'), data.streets);
    // Subtown options depend on the town; load the subzone geometry and seed the default town's
    // list before the URL state so a deep-linked `zone` lands on a real option.
    await loadSubzones(data.towns);
    await refreshSubtowns(data.default.town, data.default.flat, data.rows);

    // URL-synced filter state (see web/src/lib/urlState.ts). Declared now that the selects
    // are populated so writes land on real options. `page` is the records pager index.
    const url = createUrlState(
      [
        selectBinding('sel-town', 'town', DEFAULT_TOWN),
        selectBinding('sel-sub', 'zone', SUB_ALL),
        selectBinding('sel-flat', 'flat', DEFAULT_FLAT),
        selectBinding('sel-street', 'street', '__all'),
        selectBinding('sel-thr', 'thr', '0.1'),
        chipBinding('#record-scope', 'scope', 'scope', 'town'),
        stateBinding(
          'page',
          () => String(recordPage),
          (v) => {
            recordPage = parseInt(v, 10) || 0;
          },
          '0',
        ),
      ],
      ['town', 'zone', 'flat', 'street', 'thr', 'scope', 'page'],
    );

    recordPage = 0;
    recordTotal = Number(data.recordsTotal);

    // Deep-link restore. Gated on url.deviates(): a bare /town-analysis/ paints from the snapshot
    // and never queries the worker. On a deep link we DON'T paint the default snapshot first — it
    // would flash the wrong town and its map fit can race the linked town's fit (leaving the map
    // stuck on the default). Snapshot street options only cover the default town, so a non-default
    // town must repopulate them (a worker query) before the street value, and the scope/page.
    if (url.deviates()) {
      url.restore({ only: ['town', 'flat', 'thr', 'scope'] });
      recordScope =
        ((document.querySelector('#record-scope .chip.on') as HTMLElement | null)?.dataset
          .scope as RecordScope) ?? recordScope;
      const town = ($('sel-town') as HTMLSelectElement).value;
      const flat = ($('sel-flat') as HTMLSelectElement).value;
      // Repopulate subtowns for the linked town+flat so a `zone` param can select a real option.
      await refreshSubtowns(town, flat);
      url.applyKey('zone');
      if (town !== DEFAULT_TOWN) setStreets($('sel-street'), await streets(town));
      url.applyKey('street');
      url.applyKey('page');
      loadMap();
      loadRecords();
    } else {
      // Default view — paint immediately from JSON, no worker needed.
      paintMap(data.rows, data.default.town, data.default.flat);
      paintRecords(data.records);
    }

    // Filters go through the worker. Threshold-only changes just re-band the rows we
    // already have, so they never query. Changing town reloads its street
    // list (resetting the street filter to "all") before re-querying the map, and — in
    // "This town" scope — reloads the records for the new town (global scope is town-
    // independent, so it doesn't). The records span all flat types, so sel-flat only
    // drives the map.
    $('sel-town').addEventListener('change', async () => {
      const t = ($('sel-town') as HTMLSelectElement).value;
      const flat = ($('sel-flat') as HTMLSelectElement).value;
      // Changing town resets the subtown filter to "All" and reloads the town's streets.
      await refreshSubtowns(t, flat);
      setStreets($('sel-street'), await streets(t));
      loadMap();
      if (recordScope === 'town') {
        recordPage = 0;
        loadRecords();
      }
      url.sync();
    });
    $('sel-sub').addEventListener('change', () => {
      loadMap();
      url.sync();
    });
    $('sel-street').addEventListener('change', () => {
      loadMap();
      url.sync();
    });
    $('sel-thr').addEventListener('change', () => {
      paintMap(currentRows, currentTown, currentFlat, currentSub);
      url.sync();
    });
    $('sel-flat').addEventListener('change', async () => {
      const town = ($('sel-town') as HTMLSelectElement).value || DEFAULT_TOWN;
      const flat = ($('sel-flat') as HTMLSelectElement).value;
      // A subtown with no sales for the newly picked flat type drops out of the picker.
      await refreshSubtowns(town, flat);
      loadMap();
      url.sync();
    });
    document.querySelectorAll<HTMLButtonElement>('#record-scope .chip').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (btn.classList.contains('on')) return;
        document.querySelectorAll('#record-scope .chip').forEach((b) => b.classList.remove('on'));
        btn.classList.add('on');
        recordScope = btn.dataset.scope as RecordScope;
        recordPage = 0;
        loadRecords();
        url.sync();
      });
    });
    $('rec-prev').addEventListener('click', () => {
      if (recordPage > 0) {
        recordPage--;
        loadRecords();
        url.sync();
      }
    });
    $('rec-next').addEventListener('click', () => {
      recordPage++;
      loadRecords();
      url.sync();
    });

    // Warm the worker (decode the parquet off-thread) at idle so the first filter change is
    // instant. Save-Data / idle / prerender gated.
    warmWhenIdle();
  })();

  window.addEventListener('resize', () => {
    map.invalidateSize();
  });
</script>
